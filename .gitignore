# Build outputs and caches: everything here is re-derivable from board.toml and the tree.
/build/
/Build/
/out/
/.cache/
/refer/
/.local*/
/unixnu.lock

# Per-unit dumps. They carry the serial number, the platform UUID and proprietary firmware,
# so they stay on this machine; notes/ holds the reusable conclusions instead.
/facts/

