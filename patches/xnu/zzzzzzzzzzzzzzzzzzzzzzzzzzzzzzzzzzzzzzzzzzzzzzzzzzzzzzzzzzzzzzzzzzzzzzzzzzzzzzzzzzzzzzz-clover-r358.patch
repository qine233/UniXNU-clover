+/*
+ * Round358. Boot 137 named the receiver of SpringBoard's send destination (58:backboardd) and left
+ * backboardd itself stuck at hop=2 nm=730b with scan=no_srights -- exactly the shape rem had before
+ * r357 pointed the receiver leg at it. The bbsend row already resolves and references that hop's
+ * port in the waiter's own space, so the receiver leg needs no new translation: this reads
+ * ip_get_receiver and ip_get_receiver_name under the port's own lock (r220's discipline), resolves
+ * the receiving task with the proc_find pointer walk (r357's legs) and prints clover r358: hoprr.
+ * A hop that resolved as a port set never reaches here -- its members are r347's question, and a
+ * set has no receiver to name.
+ */
+static void __attribute__((noinline))
+clover_bb_hop_receiver(ipc_port_t port, int pid, int hop, mach_port_name_t name, uint64_t secs)
+{
+	extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+	extern struct proc *proc_find(int pid);
+	extern task_t proc_task(struct proc *p);
+	extern int proc_rele(struct proc *p);
+	ipc_space_t recv;
+	task_t owner = TASK_NULL;
+	uint32_t rnm = 0;
+	int rstate = -1;
+	int rpid = -3;
+	int pid2;
+	struct proc *pp;
+	char rc[16];
+	char row[200];
+	int len;
+
+	rc[0] = '\0';
+	io_lock(port);
+	recv = ip_get_receiver(port);
+	rnm = (uint32_t)ip_get_receiver_name(port);
+	if (recv == IPC_SPACE_NULL) {
+		rstate = 2;
+	} else if (recv->is_task == TASK_NULL) {
+		rstate = 1;
+	} else {
+		owner = recv->is_task;
+		task_reference(owner);
+		rstate = 0;
+	}
+	io_unlock(port);
+	if (owner != TASK_NULL) {
+		for (pid2 = 1; pid2 <= CLOVER_BB_SEMA_PROBE; pid2++) {
+			pp = proc_find(pid2);
+			if (pp == NULL) {
+				continue;
+			}
+			if (proc_task(pp) == owner) {
+				rpid = pid2;
+				if (proc_name_address(pp) != NULL) {
+					strlcpy(rc, proc_name_address(pp), sizeof(rc));
+				}
+				proc_rele(pp);
+				break;
+			}
+			proc_rele(pp);
+		}
+		task_deallocate(owner);
+	} else if (rstate == 1) {
+		rpid = -1;
+		strlcpy(rc, "kspace", sizeof(rc));
+	} else if (rstate == 2) {
+		rpid = -2;
+		strlcpy(rc, "none", sizeof(rc));
+	}
+	len = snprintf(row, sizeof(row),
+	    "clover r358: hoprr t=%llu pid=%d hop=%d nm=%x rnm=%x rstate=%d rpid=%d c=%s\n",
+	    (unsigned long long)secs, pid, hop, name, rnm, rstate, rpid, rc);
+	if (len > 0) {
+		row[sizeof(row) - 1] = '\0';
+		clover_emmc_probe_say(row, (unsigned int)strlen(row));
+		printf("%s", row);
+	}
+}
