+				struct proc *pfire = proc_find(58);
+
+				if (pfire != NULL) {
+					fire_pid = 58;
+					proc_rele(pfire);
+				}
+			}
+			if (fire_pid == 0) {
+				goto clover_beat_no_fire;
+			}
+			clover_bb_sample(fire_pid, sb, clover_bb_target_name, secs);
 			/*
 			 * Round324. The answer boot 109 could not get: who backboardd blocks on, re-stated
