diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
index ebbaaf7..23a5d72 100644
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -11323,9 +11323,30 @@ clover_bb_beat_thread(void *param, wait_result_t wres)
