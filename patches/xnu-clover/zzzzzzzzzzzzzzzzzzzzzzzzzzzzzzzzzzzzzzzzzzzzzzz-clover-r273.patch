 /*
+ * The contract between this file and the read in bsd/kern/kern_event.c. Both sides are this port's own code, and
+ * the array is positional only: index 0 is a pair of bits rather than a pointer, so a mismatch here cannot be
+ * caught by a type checker. That is why the indices have names and the driver of this round -- check-clover.py --
+ * asserts both sides list them in the same order.
+ */
+#define CLOVER_WL_FIELDS 11
+#define CLOVER_WL_FLAGS  0    /* bit0: the word unpacked into a kqueue; bit1: that kqueue is a workloop */
+#define CLOVER_WL_KN     1
+#define CLOVER_WL_KQ     2
+#define CLOVER_WL_KS     3    /* kq_state */
+#define CLOVER_WL_KC     4    /* kq_count */
+#define CLOVER_WL_DYN    5    /* kqwl_dynamicid */
+#define CLOVER_WL_TR     6    /* kqwl_request.tr_state */
+#define CLOVER_WL_TC     7    /* kqwl_request.tr_count */
+#define CLOVER_WL_TT     8    /* tid of kqwl_request.tr_thread, above the BINDING floor */
+#define CLOVER_WL_OW     9    /* tid of kqwl_owner */
+#define CLOVER_WL_PID    10   /* pid of the process owning the kqueue */
+
+/*
+ * Round273. What the kernel thinks of the workloop a thread is parked on.
+ *
+ * boot 59 answered the "who owns it" half of this and left the other half open: two of the debtor's threads
+ * reported hint=10 owner=3b7, and that 0x3b7 is a number the kernel reached by picking one of three branches --
+ * kqwl_owner set, or a bound request thread, or "a thread was requested" -- which the row cannot tell apart. The
+ * difference matters because those branches are different failures: kqwl_owner set means a thread is *inside* this
+ * workloop right now and not coming back, BINDING/BOUND means the workqueue handed one over and it is the same
+ * thread parked elsewhere in the census, and NEW/QUEUED means XNU asked for a servicer and never got one, which is
+ * a workqueue thread-count problem rather than a wait-graph problem. So read the request itself.
+ *
+ * The walk is the kernel's own and it lives in bsd/kern/kern_event.c next to
+ * kdp_workloop_sync_wait_find_owner, which opens the same way: kn = (struct knote *)event on the thread's
+ * wait-event word, the kqueue through knote_get_kq(), and KQ_WORKLOOP before anything touches kqwl_request. It has
+ * to live there because struct kqworkloop is only complete under BSD_KERNEL_PRIVATE, and this file is compiled
+ * against the exported copy of eventvar.h. Nothing here reaches further than that function already reached on the
+ * same boot, so this adds no new object to the probe -- only more of the ones it already walked. The KQ_WORKLOOP
+ * assert is deliberately not copied: a wait whose object is not a workloop prints wlo=0 with dyn/tr/tt/ow zeroed,
+ * because "the hint said workloop and the object disagrees" is a reading worth having on its own line.
+ *
+ * tr_thread is only meaningful from WORKQ_TR_STATE_BINDING up -- below that the union slot is the priority-queue
+ * entry -- and that bound is copied from the kernel's own check in the same function.
+ */
+struct clover_workloop_read {
+	uint8_t valid;         /* the wait-event word unpacked into a kqueue at all */
+	uint8_t workloop;      /* that kqueue says KQ_WORKLOOP */
+	uint64_t kn;           /* the wait-event word: which note this thread waits on */
+	uint64_t kq;           /* the kqueue the note names, i.e. the workloop itself */
+	uint64_t dyn;          /* kqwl_dynamicid, so five waiters can be proved to name one loop */
+	uint64_t trtid;        /* tid of kqwl_request.tr_thread, above the BINDING floor */
+	uint64_t owntid;       /* tid of kqwl_owner, the thread currently servicing */
+	uint32_t ks;           /* kq_state bits */
+	uint32_t kc;           /* kq_count: events queued on this loop */
+	uint32_t tr;           /* kqwl_request.tr_state */
+	uint32_t tc;           /* kqwl_request.tr_count: requests folded into it */
+	int32_t kqpid;         /* pid of the process that owns the kqueue */
+};
+
+static void
+clover_workloop_read(thread_t thr, struct clover_workloop_read *out)
+{
+	uint64_t raw[CLOVER_WL_FIELDS];
+
+	bzero(out, sizeof(*out));
+	bzero(raw, sizeof(raw));
+	if ((thr->state & TH_WAIT) == 0 || thr->wait_event == 0) {
+		return;
+	}
+	clover_workloop_snapshot((uint64_t)(uintptr_t)thr->wait_event, raw);
+	out->valid = (uint8_t)(raw[CLOVER_WL_FLAGS] & 1);
+	out->workloop = (uint8_t)((raw[CLOVER_WL_FLAGS] >> 1) & 1);
+	out->kn = raw[CLOVER_WL_KN];
+	out->kq = raw[CLOVER_WL_KQ];
+	out->ks = (uint32_t)raw[CLOVER_WL_KS];
+	out->kc = (uint32_t)raw[CLOVER_WL_KC];
+	out->dyn = raw[CLOVER_WL_DYN];
+	out->tr = (uint32_t)raw[CLOVER_WL_TR];
+	out->tc = (uint32_t)raw[CLOVER_WL_TC];
+	out->trtid = raw[CLOVER_WL_TT];
+	out->owntid = raw[CLOVER_WL_OW];
+	out->kqpid = (int32_t)raw[CLOVER_WL_PID];
+}
