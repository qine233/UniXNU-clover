+/*
+ * UniXNU clover round273: the whole workloop request, for the thread census in osfmk/kern/task.c.
+ *
+ * kdp_workloop_sync_wait_find_owner above answers "who owns this wait" with a single number chosen out of three
+ * branches, and the caller cannot tell which branch produced it: kqwl_owner, or a bound request thread, or
+ * STACKSHOT_WAITOWNER_THREQUESTED. On this board that collapsed reading is the one open question left about the
+ * process the desktop is waiting on -- boot 59 reported owner=3b7 twice, and 0x3b7 is a thread of that same
+ * process which the census also shows asleep, so the loop is waiting on itself. Which branch fired decides what to
+ * fix next: a set kqwl_owner means a thread went into this workloop and never came out, BINDING/BOUND means the
+ * workqueue handed a thread over and it is parked somewhere else in the process, and NEW/QUEUED/CANCELED means
+ * XNU asked for a servicer and the workqueue never answered, which is a thread-count problem rather than a
+ * wait-graph problem.
+ *
+ * This lives here rather than in the caller because struct kqworkloop is only complete under BSD_KERNEL_PRIVATE:
+ * osfmk/kern/task.c compiles against the exported copy of sys/eventvar.h, where workq_threadreq_s has been
+ * stripped. The walk is the one immediately above -- the wait-event word is a knote, the kqueue comes out of
+ * knote_get_kq(), and kqwl_request is only touched once that kqueue says KQ_WORKLOOP -- and it reads the same
+ * objects the stackshot path already reads for the same threads, holding no lock and touching no user memory.
+ * The asserts are not copied: a probe that fires every two minutes must report what it saw instead of panicking on
+ * a shape it did not expect, so a non-workloop kqueue returns wlo=0 with the request fields zeroed.
+ *
+ * The contract is positional (task.c names each index), and out[0] carries the two flags as bits so that a caller
+ * which passes a stale wait-event word still sees valid=0/workloop=0 rather than a plausible-looking zero request.
+ */
+#define CLOVER_WL_OUT_FLAGS 0
+#define CLOVER_WL_OUT_KN    1
+#define CLOVER_WL_OUT_KQ    2
+#define CLOVER_WL_OUT_KS    3
+#define CLOVER_WL_OUT_KC    4
+#define CLOVER_WL_OUT_DYN   5
+#define CLOVER_WL_OUT_TR    6
+#define CLOVER_WL_OUT_TC    7
+#define CLOVER_WL_OUT_TT    8
+#define CLOVER_WL_OUT_OW    9
+#define CLOVER_WL_OUT_PID   10
+
+void
+clover_workloop_snapshot(uint64_t event, uint64_t out[11])
+{
+	struct knote *kn = (struct knote *)(uintptr_t)event;
+	struct kqueue *kq;
+	struct kqworkloop *kqwl;
+	workq_threadreq_t kqr;
+
+	bzero(out, 11 * sizeof(*out));
+	if (event == 0) {
+		return;
+	}
+
+	kq = knote_get_kq(kn);
+	out[CLOVER_WL_OUT_FLAGS] = 1;
+	out[CLOVER_WL_OUT_KN] = (uint64_t)(uintptr_t)kn;
+	out[CLOVER_WL_OUT_KQ] = (uint64_t)(uintptr_t)kq;
+	out[CLOVER_WL_OUT_KS] = (uint64_t)kq->kq_state;
+	out[CLOVER_WL_OUT_KC] = (uint64_t)kq->kq_count;
+	out[CLOVER_WL_OUT_PID] = (uint64_t)(kq->kq_p != NULL ? proc_pid(kq->kq_p) : 0);
+	if ((kq->kq_state & KQ_WORKLOOP) == 0) {
+		return;
+	}
+
+	out[CLOVER_WL_OUT_FLAGS] |= 2;
+	kqwl = (struct kqworkloop *)kq;
+	kqr = &kqwl->kqwl_request;
+	out[CLOVER_WL_OUT_DYN] = (uint64_t)kqwl->kqwl_dynamicid;
+	out[CLOVER_WL_OUT_TR] = (uint64_t)kqr->tr_state;
+	out[CLOVER_WL_OUT_TC] = (uint64_t)kqr->tr_count;
+	if (kqr->tr_state >= WORKQ_TR_STATE_BINDING && kqr->tr_thread != THREAD_NULL) {
+		out[CLOVER_WL_OUT_TT] = thread_tid(kqr->tr_thread);
+	}
+	if (kqwl->kqwl_owner != THREAD_NULL) {
+		out[CLOVER_WL_OUT_OW] = thread_tid(kqwl->kqwl_owner);
+	}
 }
 
