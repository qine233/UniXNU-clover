+/*
+ * Round346. Round331/328 asked each hop for its receive queue and read four e=17 and four q=0.
+ * That was not a queue reading: a name whose entry holds MACH_PORT_TYPE_PORT_SET has neither a
+ * receive nor a send right, so ipc_object_translate refuses both legs and both zeros belong to a
+ * translate that never happened. The set itself is reachable with MACH_PORT_RIGHT_PORT_SET, and
+ * the members are the queues the thread is actually waiting on. This walks that set and copies
+ * each member's object, imq_msgcount, ip_srights and imq_receiver_name under the lock the
+ * translate returns; the set's own waitq address lets the row say whether the sampled thread's
+ * wait_event is this set (the receiver), and nothing is retained past the copy. Member ports are
+ * not re-locked: the set lock is the one the member walk already runs under.
+ */
+#define CLOVER_BB_PSET_MAX 8
+struct clover_bbpset_snap {
+	ipc_port_t ports[CLOVER_BB_PSET_MAX];
+	uint32_t cnts[CLOVER_BB_PSET_MAX];
+	uint32_t srs[CLOVER_BB_PSET_MAX];
+	uint32_t rns[CLOVER_BB_PSET_MAX];
+};
+static int
+clover_bb_hop_pset(task_t task, int pid, int hop, mach_port_name_t name,
+    uint64_t secs, uint64_t we)
+{
+	extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+	ipc_space_t space = task->itk_space;
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	kern_return_t kr;
+	__block struct clover_bbpset_snap snap;
+	__block uint32_t stored = 0;
+	__block uint32_t all = 0;
+	uint64_t wqaddr;
+	uint32_t i;
+	char row[220];
+	int len;
+
+	if (space == IPC_SPACE_NULL || name == MACH_PORT_NULL) {
+		return 0;
+	}
+	kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_PORT_SET, &obj);
+	if (kr != KERN_SUCCESS) {
+		return 0;
+	}
+	if (io_otype(obj) != IOT_PORT_SET) {
+		io_unlock(obj);
+		return 0;
+	}
+	wqaddr = (uint64_t)(uintptr_t)&((ipc_pset_t)obj)->ips_wqset;
+	waitq_set_foreach_member_locked(&((ipc_pset_t)obj)->ips_wqset,
+	    ^(struct waitq *wq) {
+		ipc_port_t port = ip_from_waitq(wq);
+
+		all++;
+		if (stored < CLOVER_BB_PSET_MAX) {
+			snap.ports[stored] = port;
+			snap.cnts[stored] = port->ip_messages.imq_msgcount;
+			snap.srs[stored] = port->ip_srights;
+			snap.rns[stored] = port->ip_messages.imq_receiver_name;
+			stored++;
+		}
+	});
+	io_unlock(ips_to_object((ipc_pset_t)obj));
+	/*
+	 * One header states the set and which thread is waiting on it; one row per member states the
+	 * queue. `n=` is how many rows follow and `all=` how many members existed, so a capped walk
+	 * says so instead of looking complete.
+	 */
+	len = snprintf(row, sizeof(row),
+	    "clover r346: bbset2 t=%llu pid=%d hop=%d nm=%x o=%llx n=%u all=%u"
+	    " we=%llx wq=%llx match=%u\n",
+	    (unsigned long long)secs, pid, hop, name,
+	    (unsigned long long)(uintptr_t)obj, stored, all,
+	    (unsigned long long)we, (unsigned long long)wqaddr,
+	    (we == wqaddr) ? 1u : 0u);
+	if (len > 0) {
+		row[sizeof(row) - 1] = '\0';
+		clover_emmc_probe_say(row, (unsigned int)strlen(row));
+		printf("%s", row);
+	}
+	for (i = 0; i < stored; i++) {
+		len = snprintf(row, sizeof(row),
+		    "clover r346: bbsm t=%llu hop=%d i=%u rn=%x o=%llx q=%u sr=%u\n",
+		    (unsigned long long)secs, hop, i, snap.rns[i],
+		    (unsigned long long)(uintptr_t)snap.ports[i], snap.cnts[i],
+		    snap.srs[i]);
+		if (len > 0) {
+			row[sizeof(row) - 1] = '\0';
+			clover_emmc_probe_say(row, (unsigned int)strlen(row));
+			printf("%s", row);
+		}
+	}
+	return 1;
 }
 
