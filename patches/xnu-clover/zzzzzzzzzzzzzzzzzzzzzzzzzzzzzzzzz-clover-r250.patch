+/* The one place every user-client property read of a registry entry goes through, wrapped so the
+ * question is recorded with the answer it got. Renamed body above; the name the callers use is
+ * this one, so nothing else in this file had to change. */
+static OSObject *
+IOCopyPropertyCompatible(IORegistryEntry * regEntry, const char * name)
+{
+	OSObject      * obj;
+	unsigned int    length;
+	unsigned int    value;
+
+	obj = IOCopyPropertyCompatibleReal(regEntry, name);
+	if (clover_mg_interesting(name)) {
+		value = clover_mg_answer_of(obj, &length);
+		clover_mg_note("key", name, length, value);
+	}
+	return obj;
+}
