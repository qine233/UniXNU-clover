+/*
+ * Round269. boot 55 settled that the debtor's semaphore has one waiter queued and exactly one send
+ * right left in the system, which is the middle branch: somebody can signal it and has not. Neither
+ * the semaphore nor its port says who that somebody is -- a port counts its send rights but does not
+ * point back at the spaces holding them -- so this asks the only thing that can answer.
+ *
+ * The asking is the kernel's own reverse lookup, not a scan: every ipc space keeps a reverse hash
+ * (ipc_hash.c) over its entry table that maps an object back to the name that refers to it, and
+ * ipc_hash_lookup() is the exported reader of it. It is the right instrument here for a reason beyond
+ * speed: that hash only holds pure send rights (the comment at ipc_hash.c:139 says so explicitly --
+ * receive, send-once, port-set and dead-name rights are not entered), so a hit is a process that can
+ * signal, which is the question, while a table scan would also name the receiver.
+ *
+ * CLOVER_BB_SEMA_PROBE processes is a cap, and it is printed as probed= alongside scanned= so a frame
+ * can tell "looked at every process and none of them holds it" from "stopped at the cap". Each space
+ * is read the way ipc_right_lookup_read() reads one: is_read_lock, then an SMR section, because the
+ * table can be swapped out from under a reader by a growing space (is_active_table() uses
+ * smr_serialized_load). No task lock is held here -- the census runs this after unlocking the peer,
+ * the way round266's stack walks do.
+ */
+#define CLOVER_BB_SEMA_PROBE 400
+
+static void
+clover_sema_send_holder(ipc_port_t port, uint64_t *hit_pid, uint64_t *hit_name,
+    uint64_t *hit_bits, uint32_t *scanned, uint32_t *probed)
+{
+	struct proc *pp;
+	task_t task;
+	ipc_space_t space;
+	mach_port_name_t name;
+	ipc_entry_t entry;
+	uint32_t pid;
+	extern struct proc *proc_find(int pid);
+	extern task_t proc_task(struct proc *p);
+	extern int proc_rele(struct proc *p);
+
+	*hit_pid = 0;
+	*hit_name = 0;
+	*hit_bits = 0;
+	*scanned = 0;
+	*probed = 0;
+	for (pid = 1; pid <= CLOVER_BB_SEMA_PROBE && *hit_pid == 0; pid++) {
+		pp = proc_find((int) pid);
+		if (pp == NULL) {
+			continue;
+		}
+		(*probed)++;
+		task = proc_task(pp);
+		if (task == TASK_NULL) {
+			proc_rele(pp);
+			continue;
+		}
+		space = task->itk_space;
+		if (space != IPC_SPACE_NULL) {
+			(*scanned)++;
+			is_read_lock(space);
+			if (is_active(space)) {
+				smr_ipc_enter();
+				if (ipc_hash_lookup(space, (ipc_object_t) port, &name, &entry)
+				    == TRUE) {
+					*hit_pid = pid;
+					*hit_name = (uint64_t) name;
+					*hit_bits = (uint64_t) IE_BITS_TYPE(entry->ie_bits);
+				}
+				smr_ipc_leave();
+			}
+			is_read_unlock(space);
+		}
+		proc_rele(pp);
+	}
 }
 
