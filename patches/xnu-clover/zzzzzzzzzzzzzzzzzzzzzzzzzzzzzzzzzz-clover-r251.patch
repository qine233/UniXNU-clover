+/* Round251. IOCopyLogNameForPID hands back "pid <n>, <name>"; boot 38 showed the cost of printing
+ * that from the front -- a 16-byte field cut the name to "SpringBo" after spending eight bytes on a
+ * pid that is printed again two fields later. The name is what identifies the asker, so take the
+ * part after the comma-space and keep the pid column for the number. */
+static const char *
+clover_mg_short(const char *logname)
+{
+	const char *p;
+
+	for (p = logname; p[1] != '\0'; p++) {
+		if (p[0] == ',' && p[1] == ' ') {
+			return p + 2;
+		}
+	}
+	return logname;
+}
+
+/* Round251. The tally is the reading that must not depend on the ring's capacity: a boot where
+ * every process asks often enough to wrap 24 rows still has to answer "did this pid ask at all",
+ * because that is the question the frame is being read for. */
+static void
+clover_mg_tally(int pid, const char *name, bool path)
+{
+	struct clover_mg_who *entry = NULL;
+	uint32_t              i;
+
+	for (i = 0; i < clover_mg_whos; i++) {
+		if (clover_mg_who[i].pid == pid) {
+			entry = &clover_mg_who[i];
+			break;
+		}
+	}
+	if (entry == NULL) {
+		if (clover_mg_whos >= CLOVER_MG_WHO) {
+			return;
+		}
+		entry = &clover_mg_who[clover_mg_whos++];
+		entry->pid = pid;
+		entry->paths = 0;
+		entry->keys = 0;
+		snprintf(entry->name, sizeof (entry->name), "%.20s", name);
+	}
+	if (path) {
+		entry->paths++;
+	} else {
+		entry->keys++;
+	}
+}
