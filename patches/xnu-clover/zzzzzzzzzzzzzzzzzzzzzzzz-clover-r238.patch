+static void
+clover_ulock_read_word(struct clover_ulock_row *row, uint64_t secs)
+{
+	extern struct proc *proc_find(int pid);
+	extern task_t proc_task(struct proc *p);
+	extern int proc_rele(struct proc *p);
+	struct proc *p;
+	task_t task;
+	uint32_t word = 0;
+
+	row->word_seen = 0;
+	p = proc_find(row->pid);
+	if (p == NULL) {
+		return;
+	}
+	task = proc_task(p);
+	if (task != TASK_NULL &&
+	    clover_user_read32(vm_map_pmap(task->map), row->addr, &word)) {
+		row->word = word;
+		row->word_secs = secs;
+		row->word_seen = 1;
+	}
