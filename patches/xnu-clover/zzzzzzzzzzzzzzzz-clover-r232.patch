+/*
+ * Round232. A hop name that translates under neither SEND nor RECEIVE can be a
+ * port set: a set's receive right lives in its own entry type, and a receiver
+ * that serves a member port blocks on the set, not on the member's name. The
+ * set object comes back locked from the translate; the member walk runs under
+ * that lock and copies each member's object, queue count, seqno and receiver
+ * name into one row, so the member object can be matched against the port a
+ * blocked send was addressed to. Members are not lockable here (the set lock is
+ * held), and nothing is retained past the row.
+ */
+static void
+clover_pset_report(ipc_pset_t pset, const char *tag, uint64_t secs,
+    const char *rn, mach_port_name_t name)
+{
+	char memb[220];
+	char *mp = memb;
+	char line[320];
+	__block uint32_t n = 0;
+	__block uint32_t all = 0;
+	__block int off = 0;
+	int len;
+
+	memb[0] = '\0';
+	waitq_set_foreach_member_locked(&pset->ips_wqset, ^(struct waitq *wq) {
+		ipc_port_t port = ip_from_waitq(wq);
+
+		all++;
+		if (n >= 8 || off >= (int)sizeof(memb) - 32) {
+			return;
+		}
+		off += snprintf(mp + off, sizeof(memb) - (size_t)off,
+		    "%s%llx:%u:%u:%x", n ? "," : "",
+		    (unsigned long long)(uintptr_t)port,
+		    (unsigned)port->ip_messages.imq_msgcount,
+		    (unsigned)port->ip_messages.imq_seqno,
+		    port->ip_messages.imq_receiver_name);
+		n++;
+	});
+	io_unlock(ips_to_object(pset));
+	len = snprintf(line, sizeof(line),
+	    "clover %s: bbset t=%llu %s nm=%x o=%llx n=%u all=%u m=%s\n",
+	    rn, (unsigned long long)secs, tag, name,
+	    (unsigned long long)(uintptr_t)pset, n, all, memb);
+	if (len > 0) {
+		line[sizeof(line) - 1] = '\0';
+		printf("%s", line);
+	}
+}
