 #define CLOVER_BB_PSET_MAX 8
 struct clover_bbpset_snap {
@@ -12672,6 +12675,7 @@
 	uint32_t cnts[CLOVER_BB_PSET_MAX];
 	uint32_t srs[CLOVER_BB_PSET_MAX];
 	uint32_t rns[CLOVER_BB_PSET_MAX];
