 			clover_emmc_probe_say(row, (unsigned int)strlen(row));
 			printf("%s", row);
 		}
 	}
+	/*
+	 * Round347. Boot 126 read nine of ten member ports holding send rights with every queue empty,
+	 * which says the doors exist but not who was handed the key. Each member with ip_srights>0 is
+	 * asked outward on the two legs r331 already uses: the kernel's reverse hash (pure-send entries
+	 * only, so hits is a lower bound) and a complete walk of the waiter's own table (own= is the
+	 * count, which answers whether backboardd is the sender). ip_mscount rides beside them: a right
+	 * that exists and has never been sent reads ms=0 with sr>0, while a door that has been used and
+	 * drained reads ms>0 with q=0. Members are held on the references taken under the set lock.
+	 */
+	for (i = 0; i < stored; i++) {
+		uint32_t hp[2];
+		uint32_t hn[2];
+		uint64_t ht[2];
+		char hc[32];
+		uint32_t on[1];
+		uint64_t ob[1];
+		uint32_t hits = 0;
+		uint32_t probed = 0;
+		uint32_t scanned = 0;
+		uint32_t selfhit = 0;
+		uint32_t matches = 0;
+		uint32_t entries = 0;
+		uint32_t j;
+
+		if (snap.srs[i] == 0) {
+			continue;
+		}
+		clover_port_hash_holders(snap.ports[i], task, hp, hn, ht, hc, 2, &hits,
+		    &probed, &scanned, &selfhit);
+		if (space != IPC_SPACE_NULL) {
+			clover_space_obj_names(space, (ipc_object_t)snap.ports[i], on, ob,
+			    1, &matches, &entries);
+		}
+		len = snprintf(row, sizeof(row),
+		    "clover r347: bbsmh t=%llu hop=%d i=%u rn=%x o=%llx ms=%u sr=%u"
+		    " own=%u hits=%u probed=%u scanned=%u\n",
+		    (unsigned long long)secs, hop, i, snap.rns[i],
+		    (unsigned long long)(uintptr_t)snap.ports[i], snap.mss[i],
+		    snap.srs[i], matches, hits, probed, scanned);
+		if (len > 0) {
+			row[sizeof(row) - 1] = '\0';
+			clover_emmc_probe_say(row, (unsigned int)strlen(row));
+			printf("%s", row);
+		}
+		for (j = 0; j < hits && j < 2; j++) {
+			len = snprintf(row, sizeof(row),
+			    "clover r347: bbsmhold t=%llu hop=%d i=%u j=%u pid=%u c=%s"
+			    " nm=%x ty=%s raw=%llx\n",
+			    (unsigned long long)secs, hop, i, j, hp[j],
+			    hc[j * 16], hn[j],
+			    clover_right_type_word((ipc_entry_bits_t)ht[j]),
+			    (unsigned long long)ht[j]);
+			if (len > 0) {
+				row[sizeof(row) - 1] = '\0';
+				clover_emmc_probe_say(row, (unsigned int)strlen(row));
+				printf("%s", row);
+			}
+		}
+	}
+	for (i = 0; i < stored; i++) {
+		ip_release(snap.ports[i]);
+	}
 	return 1;
 }
 
