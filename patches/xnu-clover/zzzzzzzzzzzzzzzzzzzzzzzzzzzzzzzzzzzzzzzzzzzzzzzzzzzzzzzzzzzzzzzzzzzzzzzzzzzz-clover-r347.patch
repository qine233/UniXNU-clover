 };
 static int
 clover_bb_hop_pset(task_t task, int pid, int hop, mach_port_name_t name,
@@ -12711,6 +12715,13 @@
 			snap.cnts[stored] = port->ip_messages.imq_msgcount;
 			snap.srs[stored] = port->ip_srights;
 			snap.rns[stored] = port->ip_messages.imq_receiver_name;
+			snap.mss[stored] = port->ip_mscount;
+			/*
+			 * Round347: the member is about to be asked who holds its send right after the set
+			 * lock is dropped, and a member port can be destroyed in that gap. The set lock is the
+			 * last instant at which a reference can be taken without racing a recycled address.
+			 */
+			ip_reference(port);
 			stored++;
 		}
 	});
@@ -12734,16 +12745,78 @@
 	}
 	for (i = 0; i < stored; i++) {
 		len = snprintf(row, sizeof(row),
-		    "clover r346: bbsm t=%llu hop=%d i=%u rn=%x o=%llx q=%u sr=%u\n",
+		    "clover r346: bbsm t=%llu hop=%d i=%u rn=%x o=%llx q=%u sr=%u ms=%u\n",
 		    (unsigned long long)secs, hop, i, snap.rns[i],
 		    (unsigned long long)(uintptr_t)snap.ports[i], snap.cnts[i],
-		    snap.srs[i]);
+		    snap.srs[i], snap.mss[i]);
 		if (len > 0) {
