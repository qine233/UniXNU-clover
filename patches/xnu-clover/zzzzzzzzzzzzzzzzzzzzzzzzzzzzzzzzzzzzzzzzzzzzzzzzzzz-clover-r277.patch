+/*
+ * Round277. Boot 63 printed nothing from this function at all -- no r243 row, no r275 row, no r276 row --
+ * and its kernel log stops at 1499.4 s, one second before the gate below, with no panic record for the boot
+ * either. That is the reading a missing line cannot answer: "never started", "started and died in the walk",
+ * and "printed everything but the tee had a ten-second backlog when the board stopped" all look the same on
+ * the kernel log, because the kernel ring reaches the card through the driver's msgbuf consumer, which runs
+ * at most sixteen block writes per pass. So the census now announces itself on the channel that does not go
+ * through the kernel log at all: r212's probe relay, straight into the driver's own ring. Every row below is
+ * a relay row, and a round that starts but never finishes says where it stopped.
+ */
+extern "C" unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+static int clover_census_calls;
+
+#define CLOVER_CENSUS_SAY(...) do { \
+	char _row[96]; \
+	int  _n = snprintf(_row, sizeof(_row), __VA_ARGS__); \
+	if (_n > 0) { \
+		clover_emmc_probe_say(_row, (unsigned int) (_n < (int) sizeof(_row) ? _n : (int) sizeof(_row) - 1)); \
+	} \
+} while (0)
 
