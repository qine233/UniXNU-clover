+/*
+ * Round304. One row, two places. Boot 93 read the census head off the card and nothing after it: the
+ * fire's thread rows, its chain rows and its own closing row all ride printf -> msgbuf -> the driver's
+ * tee, and the tee only runs at the tail of a block request. That boot stopped seconds after the head
+ * with no further tail, so the rows this port has been built to measure were sitting in the kernel's
+ * log buffer and never reached the card -- an absence that says nothing at all about the chain, which
+ * is the false-empty round249's exemption was invented to stop and which rounds295 through 300 have
+ * each argued about once more.
+ *
+ * The relay is round212's, unchanged: the same bytes the console gets are copied into the driver's own
+ * BSS ring, where they wait for a consumer that needs neither the msgbuf, nor the tee's cursor, nor a
+ * panic. Nothing here sleeps and nothing here takes a lock -- the handover is one atomic slot counter
+ * plus a copy -- so it stays legal on the census path, which walks other tasks' thread lists holding a
+ * try-lock it has dropped before the row is printed. The buffer is the driver's own slot size, 256: a
+ * row longer than that truncates at the same byte in both copies, so the card and the console can never
+ * disagree about what a field said. The widest row any boot has measured is 228.
+ */
+extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+
+static void
+clover_census_row(const char *line)
+{
+	printf("%s", line);
+	clover_emmc_probe_say(line, (unsigned int)strlen(line));
+}
 
