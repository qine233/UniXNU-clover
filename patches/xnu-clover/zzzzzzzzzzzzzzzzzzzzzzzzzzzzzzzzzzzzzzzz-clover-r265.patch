 #define CLOVER_BB_CENSUS 20
 #define CLOVER_BB_M2_TRAP  (-47)
+
+#define CLOVER_BB_PEER_ROWS 12
+
+/*
+ * Round265. The receiver's task behind a name in someone else's space, with the
+ * reference the caller has to hold: a task can exit while its threads are being
+ * walked, and unlike clover_sb_port_owner this is not a label, it is the object
+ * the census below runs on.
+ */
+static task_t
+clover_bb_peer_task(task_t task, mach_port_name_t name)
+{
+	ipc_space_t space;
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	task_t peer = TASK_NULL;
+	kern_return_t kr;
+
+	if (name == MACH_PORT_NULL) {
+		return TASK_NULL;
+	}
+	space = task->itk_space;
+	if (space == IPC_SPACE_NULL) {
+		return TASK_NULL;
+	}
+	kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_SEND, &obj);
+	if (kr != KERN_SUCCESS) {
+		kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_RECEIVE,
+		    &obj);
+	}
+	if (kr != KERN_SUCCESS) {
+		return TASK_NULL;
+	}
+	if (io_otype(obj) == IOT_PORT) {
+		ipc_space_t recv = ip_get_receiver((ipc_port_t)obj);
+
+		if (recv != IPC_SPACE_NULL && recv->is_task != TASK_NULL) {
+			peer = recv->is_task;
+			task_reference(peer);
+		}
+	}
+	io_unlock(obj);
+	return peer;
+}
+
+/*
+ * Round265. Boot 51 named the debtor of the one outstanding request in the
+ * blocked process -- pid 140, com.apple.datamigrator, four beats running,
+ * rcv=0xc903 with an empty queue and no deadline -- and a name is not an
+ * explanation. The same ruler goes onto it: every thread it has, what it sleeps
+ * on, whether it is itself in the trap with a request of its own, and that
+ * request's owner resolved in the peer's own space. It never calls
+ * clover_bb_sample, so a debtor that is itself a waiter cannot recurse.
+ */
+static void
+clover_bb_peer_census(task_t peer, uint64_t secs)
+{
+	thread_t thr;
+	unsigned int i;
+	struct proc *pp;
+	char *pname;
+	char comm[16];
+	uint64_t ptid[CLOVER_BB_PEER_ROWS];
+	uint64_t pcont[CLOVER_BB_PEER_ROWS];
+	uint64_t pdl[CLOVER_BB_PEER_ROWS];
+	uint64_t prm[CLOVER_BB_PEER_ROWS];
+	uint64_t prc[CLOVER_BB_PEER_ROWS];
+	uint64_t pto[CLOVER_BB_PEER_ROWS];
+	uint32_t pst[CLOVER_BB_PEER_ROWS];
+	uint32_t pn = 0;
+	uint32_t pcall = 0;
+	uint32_t pwait = 0;
+	uint32_t prun = 0;
+	uint32_t prx = 0;
+	uint32_t ptm = 0;
+	uint64_t pns;
+	int busy = 0;
+
+	if (!lck_mtx_try_lock(&peer->lock)) {
+		busy = 1;
+	} else {
+		queue_iterate(&peer->threads, thr, thread_t, task_threads) {
+			arm_saved_state_t *ss;
+
+			pcall++;
+			if ((thr->state & TH_WAIT) != 0) {
+				pwait++;
+			}
+			if ((thr->state & TH_RUN) != 0 &&
+			    (thr->state & TH_WAIT) == 0) {
+				prun++;
+			}
+			if (pn >= CLOVER_BB_PEER_ROWS) {
+				continue;
+			}
+			ss = get_user_regs(thr);
+			ptid[pn] = thr->thread_id;
+			pst[pn] = thr->state;
+			pcont[pn] = (uint64_t)(uintptr_t)thr->continuation;
+			pdl[pn] = 0;
+			prm[pn] = 0;
+			prc[pn] = 0;
+			pto[pn] = 0;
+			if (thr->wait_timer_armed && thr->wait_timer != NULL) {
+				pns = 0;
+				absolutetime_to_nanoseconds(
+				    thr->wait_timer->tc_soft_deadline, &pns);
+				pns /= 1000000000ULL;
+				pdl[pn] = pns > secs ? pns - secs : 1;
+			}
+			if (pdl[pn] != 0) {
+				ptm++;
+			}
+			if (ss != NULL && (uintptr_t)ss != (uintptr_t)-1 &&
+			    !is_saved_state32(ss) && (thr->state & TH_RUN) == 0 &&
+			    (int64_t)saved_state64(ss)->x[16] == CLOVER_BB_M2_TRAP) {
+				prm[pn] = (uint64_t)saved_state64(ss)->x[3];
+				prc[pn] = (uint64_t)saved_state64(ss)->x[5] >> 32;
+				pto[pn] = (uint64_t)saved_state64(ss)->x[7];
+				if ((uint32_t)prm[pn] == 0) {
+					prx++;
+				}
+			}
+			pn++;
+		}
+		lck_mtx_unlock(&peer->lock);
+	}
+	comm[0] = '\0';
+	pp = (struct proc *)get_bsdtask_info(peer);
+	pname = (pp != NULL) ? proc_name_address(pp) : NULL;
+	if (pname != NULL) {
+		strlcpy(comm, pname, sizeof(comm));
+	}
+	printf("clover r265: peer t=%llu pid=%d comm=%s%s threads=%u shown=%u"
+	    " hidden=%u wait=%u run=%u rx=%u tm=%u\n", (unsigned long long)secs,
+	    task_pid(peer), comm, busy ? "busy" : "-", pcall, pn,
+	    (pcall > pn) ? pcall - pn : 0, pwait, prun, prx, ptm);
+	if (busy) {
+		return;
+	}
+	for (i = 0; i < pn; i++) {
+		char ppeer[24];
+		uint32_t pmc = 0;
+		uint32_t psr = 0;
+		uint32_t pmmc = 0;
+		uint32_t pmsr = 0;
 
+		/*
+		 * Three shapes again, because boot 50 proved that an unresolved name and
+		 * an absent one print alike otherwise. A thread outside the trap has no
+		 * port side to name at all, so its peer= stays empty and that is a third
+		 * reading, not a failure to resolve.
+		 */
+		ppeer[0] = '\0';
+		if ((uint32_t)prm[i] != 0) {
+			clover_sb_port_owner(peer, (mach_port_name_t)prm[i], ppeer,
+			    sizeof(ppeer));
+			if (ppeer[0] == '\0') {
+				strlcpy(ppeer, "?", sizeof(ppeer));
+			}
+			clover_sb_port_mail(peer, (mach_port_name_t)prm[i], &pmmc,
+			    &pmsr);
+		} else if ((uint32_t)prc[i] != 0) {
+			strlcpy(ppeer, "none", sizeof(ppeer));
+		}
+		if ((uint32_t)prc[i] != 0) {
+			clover_sb_port_mail(peer, (mach_port_name_t)prc[i], &pmc, &psr);
+		}
+		printf("clover r265: pth tid=%llx st=%x cont=%llx dl=%llx"
+		    " rcv=%x remote=%x to=%llx mc=%u sr=%x rmc=%u rsr=%x peer=%s\n",
+		    (unsigned long long)ptid[i], pst[i],
+		    (unsigned long long)pcont[i], (unsigned long long)pdl[i],
+		    (unsigned int)prc[i], (unsigned int)(uint32_t)prm[i],
+		    (unsigned long long)pto[i], pmc, psr, pmmc, pmsr, ppeer);
+	}
+}
