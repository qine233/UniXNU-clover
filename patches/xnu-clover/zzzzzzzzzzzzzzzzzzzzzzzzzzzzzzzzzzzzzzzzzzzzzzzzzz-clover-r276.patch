+/*
+ * Round276. Boot 62 caught the matcher above looking for the wrong thing: the service this port is
+ * about to publish calls itself "Native keystore state service" (drivers/NativeKeyStoreEvents/
+ * NativeKeyStoreEvents.cpp:145), which is lowercase, so a case-sensitive "KeyStore" test would have
+ * kept answering keystore_services=0 even after a successful publish -- an instrument that cannot see
+ * the thing it asks about, this time pointing the wrong way. The case fold is written out because
+ * this translation unit pulls in no <ctype.h>.
+ */
+static char
+clover_lower(char c)
+{
+	if (c >= 'A' && c <= 'Z') {
+		return (char) (c + ('a' - 'A'));
+	}
+	return c;
+}
+
