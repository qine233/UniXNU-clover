diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -10668,7 +10668,164 @@
  * never changes is still read while the sender's batch sits still. */
 static int clover_bb_target_pid;
 static mach_port_name_t clover_bb_target_name;
+
+/*
+ * Round237. Boot 25 put backboardd's main thread in ___ulock_wait on a word at
+ * heap+0x34 and left two questions the sampler cannot answer: whether that wait
+ * is ever woken, and what the object around the word held at the time. The
+ * table below is fed from sys_ulock_wait2() and sys_ulock_wake() for the latched
+ * pid only. Addresses are claimed once and never recycled, so a row that has
+ * been printed keeps the same meaning for the rest of the boot; a full table
+ * counts overflow instead of evicting.
+ */
+#define CLOVER_ULOCK_SLOTS 12
+struct clover_ulock_row {
+	uint64_t addr;
+	uint32_t waits;
+	uint32_t blocked;
+	uint32_t woken;
+	uint32_t wakes;
+	uint32_t last_op;
+	int32_t last_wait_rc;
+	int32_t last_wake_rc;
+};
+static struct clover_ulock_row clover_ulock_rows[CLOVER_ULOCK_SLOTS];
+static uint32_t clover_ulock_overflow;
 
+static struct clover_ulock_row *
+clover_ulock_slot(uint64_t addr)
+{
+	unsigned int i;
+
+	for (i = 0; i < CLOVER_ULOCK_SLOTS; i++) {
+		if (clover_ulock_rows[i].addr == addr) {
+			return &clover_ulock_rows[i];
+		}
+	}
+	for (i = 0; i < CLOVER_ULOCK_SLOTS; i++) {
+		uint64_t zero = 0;
+
+		if (clover_ulock_rows[i].addr != 0) {
+			continue;
+		}
+		if (__atomic_compare_exchange_n(&clover_ulock_rows[i].addr,
+		    &zero, addr, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+			clover_ulock_rows[i].waits = 0;
+			clover_ulock_rows[i].blocked = 0;
+			clover_ulock_rows[i].woken = 0;
+			clover_ulock_rows[i].wakes = 0;
+			clover_ulock_rows[i].last_op = 0;
+			clover_ulock_rows[i].last_wait_rc = 0;
+			clover_ulock_rows[i].last_wake_rc = 0;
+			return &clover_ulock_rows[i];
+		}
+	}
+	__atomic_add_fetch(&clover_ulock_overflow, 1, __ATOMIC_RELAXED);
+	return NULL;
+}
+
+void
+clover_ulock_note_wait(int pid, uint64_t addr, uint32_t op)
+{
+	struct clover_ulock_row *row;
+
+	if (pid <= 0 || pid != clover_bb_target_pid || addr == 0) {
+		return;
+	}
+	row = clover_ulock_slot(addr);
+	if (row == NULL) {
+		return;
+	}
+	__atomic_add_fetch(&row->waits, 1, __ATOMIC_RELAXED);
+	row->last_op = op;
+}
+
+void
+clover_ulock_note_block(int pid, uint64_t addr, uint32_t op)
+{
+	struct clover_ulock_row *row;
+
+	if (pid <= 0 || pid != clover_bb_target_pid || addr == 0) {
+		return;
+	}
+	row = clover_ulock_slot(addr);
+	if (row == NULL) {
+		return;
+	}
+	__atomic_add_fetch(&row->blocked, 1, __ATOMIC_RELAXED);
+	row->last_op = op;
+}
+
+void
+clover_ulock_note_woken(int pid, uint64_t addr, uint32_t op, int32_t rc)
+{
+	struct clover_ulock_row *row;
+
+	if (pid <= 0 || pid != clover_bb_target_pid || addr == 0) {
+		return;
+	}
+	row = clover_ulock_slot(addr);
+	if (row == NULL) {
+		return;
+	}
+	__atomic_add_fetch(&row->woken, 1, __ATOMIC_RELAXED);
+	row->last_wait_rc = rc;
+	if (op != 0) {
+		row->last_op = op;
+	}
+}
+
+void
+clover_ulock_note_wake(int pid, uint64_t addr, uint32_t op, int32_t rc)
+{
+	struct clover_ulock_row *row;
+
+	if (pid <= 0 || pid != clover_bb_target_pid || addr == 0) {
+		return;
+	}
+	row = clover_ulock_slot(addr);
+	if (row == NULL) {
+		return;
+	}
+	__atomic_add_fetch(&row->wakes, 1, __ATOMIC_RELAXED);
+	row->last_wake_rc = rc;
+	row->last_op = op;
+}
+
+/*
+ * One line per address answers whether a wait that is still there has ever been
+ * woken: w is the number of waits, b the ones that blocked, k the ones that came
+ * back through ulock_wait_continue, s the wake calls from the same pid. The
+ * beat prints this every two minutes, so the counters read as a time series.
+ */
+void
+clover_ulock_dump(uint64_t secs)
+{
+	unsigned int i;
+	unsigned int shown = 0;
+
+	for (i = 0; i < CLOVER_ULOCK_SLOTS && shown < 8; i++) {
+		struct clover_ulock_row *row = &clover_ulock_rows[i];
+
+		if (row->addr == 0 ||
+		    (row->waits + row->blocked + row->woken + row->wakes) == 0) {
+			continue;
+		}
+		printf("clover r237: ulock t=%llu pid=%d a=%llx w=%u b=%u k=%u"
+		    " s=%u wr=%d sw=%d op=%x\n",
+		    (unsigned long long)secs, clover_bb_target_pid,
+		    (unsigned long long)row->addr, row->waits, row->blocked,
+		    row->woken, row->wakes, row->last_wait_rc,
+		    row->last_wake_rc, row->last_op);
+		shown++;
+	}
+	if (clover_ulock_overflow != 0) {
+		printf("clover r237: ulocko t=%llu pid=%d n=%u\n",
+		    (unsigned long long)secs, clover_bb_target_pid,
+		    clover_ulock_overflow);
+	}
+}
