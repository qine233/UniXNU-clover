+			 * Round349: sample the holder in the same fire, so "the right exists" is followed by
+			 * what the right's owner is doing at that instant.
+			 */
+			clover_bb_holder_sample((int)hp[j], hop, (int)i, (int)j,
+			    (mach_port_name_t)hn[j], secs);
 		}
 	}
 	for (i = 0; i < stored; i++) {
