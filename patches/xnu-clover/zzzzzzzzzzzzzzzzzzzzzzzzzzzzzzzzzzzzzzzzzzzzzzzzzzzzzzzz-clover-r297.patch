+/*
+ * Round297. The same translation, but the answer this time is the object itself -- one number,
+ * printed only to be compared with another printing of the same number. It exists because every
+ * other name in the chain row is a per-task index: hop 2's remote=7f07 is an index in the sender's
+ * space and hop 3's rcv=1917 is an index in the receiver's, so no reader -- the kernel or a human
+ * holding two rows -- can say whether the request the sender placed is addressed to the port the
+ * receiver is blocked on. That question decides what boot 84's qmc=0 means, and the object pointer
+ * answers it across address spaces because there is exactly one ipc_object per port in the kernel.
+ *
+ * The lock discipline is clover_sb_port_mail's: ipc_object_translate() returns the object locked,
+ * nothing is read from it here, and io_unlock() runs before returning. The value is an identity,
+ * not a reference -- printed and compared, never dereferenced after the unlock -- so a port freed
+ * between two hops can only make the comparison say no, never fault.
+ */
+static uintptr_t
+clover_sb_port_obj(task_t task, mach_port_name_t name)
+{
+	ipc_space_t space;
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	kern_return_t kr;
+
+	if (name == MACH_PORT_NULL) {
+		return 0;
+	}
+	space = task->itk_space;
+	if (space == IPC_SPACE_NULL) {
+		return 0;
+	}
+	kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_RECEIVE, &obj);
+	if (kr != KERN_SUCCESS) {
+		kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_SEND, &obj);
+	}
+	if (kr != KERN_SUCCESS) {
+		return 0;
+	}
+	io_unlock(obj);
+	return (uintptr_t)obj;
+}
