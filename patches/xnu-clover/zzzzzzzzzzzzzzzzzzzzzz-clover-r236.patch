+extern unsigned int ml_phys_read_64(addr64_t paddr64);
+
+/*
+ * Round236. A frame chain that belongs to another task cannot be read with copyin: copyin
+ * resolves the address in the calling thread's map, and the caller here is the sampler, not
+ * backboardd. The page table still names the backing page, so each frame address is
+ * translated with pmap_find_phys and its bytes are read from the physical page. ml_phys_read_64
+ * returns one 32-bit word, so a 64-bit slot is two reads, each with its own translation --
+ * a frame record may straddle a page.
+ */
+static int
+clover_user_read32(pmap_t pmap, uint64_t addr, uint32_t *value)
+{
+	ppnum_t page = pmap_find_phys(pmap, (addr64_t)addr);
+	uint64_t phys;
+
+	if (page == 0) {
+		return 0;
+	}
+	phys = ((uint64_t)page << PAGE_SHIFT) | (addr & (PAGE_SIZE - 1));
+	*value = (uint32_t)ml_phys_read_64((addr64_t)phys);
+	return 1;
+}
+
+static uint32_t
+clover_user_bp_walk(pmap_t pmap, uint64_t fp, uint64_t sp, uint64_t *frames,
+    uint32_t frames_max)
+{
+	uint32_t i = 0;
+	uint64_t limit;
+
+	if (pmap == PMAP_NULL || sp == 0) {
+		return 0;
+	}
+	limit = sp + 0x40000;
+	while (i < frames_max && fp != 0 && (fp & 7) == 0 &&
+	    fp >= sp && fp < limit) {
+		uint32_t lo, hi, rlo, rhi;
+		uint64_t parent, ret;
+
+		if (!clover_user_read32(pmap, fp, &lo) ||
+		    !clover_user_read32(pmap, fp + 4, &hi) ||
+		    !clover_user_read32(pmap, fp + 8, &rlo) ||
+		    !clover_user_read32(pmap, fp + 12, &rhi)) {
+			break;
+		}
+		parent = (uint64_t)lo | ((uint64_t)hi << 32);
+		ret = (uint64_t)rlo | ((uint64_t)rhi << 32);
+		if (ret == 0) {
+			break;
+		}
+		frames[i++] = ret;
+		if (parent <= fp) {
+			break;
+		}
+		fp = parent;
+	}
+	return i;
+}
