+/*
+ * clover r155: dyld's own preflight reads 0x4000 bytes of a cache file and then
+ * accepts or rejects it on header fields alone, without printing anything. Dump
+ * those fields -- and the length vnode_size() reports, which the signature check
+ * compares against -- so each frame carries the verdict for each file. The .01
+ * open proves the main cache already passed the same checks; these readings say
+ * which check the subcache would fail, if dyld never asks the kernel for more.
+ * The mapping array lives past the 512-byte first read, so it gets a second one.
+ */
+static void
+clover_cache_header(vnode_t vp, const char *path)
+{
+	static const char clover_digits[] = "0123456789";
+	uint8_t hdr[512];
+	uint8_t maps[8 * 32];
+	off_t length = 0;
+	size_t plen = strlen(path);
+	const char *tag = "main";
+	uint64_t sig_offset = 0;
+	uint64_t sig_size = 0;
+	uint64_t cache_type = 0;
+	uint32_t map_offset = 0;
+	uint32_t map_count = 0;
+	uint32_t platform = 0;
+	uint32_t flags_word = 0;
+	uint32_t alt_platform = 0;
+	uint32_t sub_offset = 0;
+	uint32_t sub_count = 0;
+	uint32_t sub_type = 0;
+	uint64_t m0_offset = 0;
+	uint64_t ml_offset = 0;
+	uint32_t m0_max = 0;
+	uint32_t ml_max = 0;
+	int hdr_resid = 0;
+	int hdr_error;
+
+	if (plen >= 3 && path[plen - 3] == '.' &&
+	    strchr(clover_digits, path[plen - 2]) != NULL &&
+	    strchr(clover_digits, path[plen - 1]) != NULL) {
+		tag = path + plen - 3;
+	}
+
+	memset(hdr, 0, sizeof(hdr));
+	hdr_error = vn_rdwr(UIO_READ, vp, hdr, sizeof(hdr), 0, UIO_SYSSPACE,
+	    IO_NODELOCKED | IO_NOAUTH, kauth_cred_get(), &hdr_resid,
+	    current_proc());
+	(void)vnode_size(vp, &length, vfs_context_current());
+	if (hdr_error == 0) {
+		memcpy(&map_offset, hdr + 16, sizeof(map_offset));
+		memcpy(&map_count, hdr + 20, sizeof(map_count));
+		memcpy(&sig_offset, hdr + 40, sizeof(sig_offset));
+		memcpy(&sig_size, hdr + 48, sizeof(sig_size));
+		memcpy(&cache_type, hdr + 104, sizeof(cache_type));
+		memcpy(&platform, hdr + 216, sizeof(platform));
+		memcpy(&flags_word, hdr + 220, sizeof(flags_word));
+		memcpy(&alt_platform, hdr + 368, sizeof(alt_platform));
+		memcpy(&sub_offset, hdr + 392, sizeof(sub_offset));
+		memcpy(&sub_count, hdr + 396, sizeof(sub_count));
+		memcpy(&sub_type, hdr + 456, sizeof(sub_type));
+	}
+	printf("clover r155: hdr %s vp=%p len=%lld sig=%llu+%llu err=%d/%d\n",
+	    tag, vp, (long long)length, sig_offset, sig_size, hdr_error,
+	    hdr_resid);
+	printf("clover r155: hdr %s off=%u n=%u ty=%llu/%u plat=%u/%u fl=%x\n",
+	    tag, map_offset, map_count, cache_type, sub_type, platform,
+	    alt_platform, flags_word);
+	if (hdr_error == 0 && map_count != 0 && map_count <= 8) {
+		int map_resid = 0;
+		int map_error = vn_rdwr(UIO_READ, vp, maps, map_count * 32,
+		    map_offset, UIO_SYSSPACE, IO_NODELOCKED | IO_NOAUTH,
+		    kauth_cred_get(), &map_resid, current_proc());
+
+		if (map_error == 0) {
+			uint32_t last = map_count - 1;
+
+			memcpy(&m0_offset, maps + 16, sizeof(m0_offset));
+			memcpy(&m0_max, maps + 24, sizeof(m0_max));
+			memcpy(&ml_offset, maps + last * 32 + 16,
+			    sizeof(ml_offset));
+			memcpy(&ml_max, maps + last * 32 + 24, sizeof(ml_max));
+			printf("clover r155: hdr %s m0=%llu/%x ml=%llu/%x subs=%u@%u\n",
+			    tag, m0_offset, m0_max, ml_offset, ml_max,
+			    sub_count, sub_offset);
+		} else {
+			printf("clover r155: hdr %s map err=%d resid=%d\n", tag,
+			    map_error, map_resid);
+		}
+	}
+}
+
+/*
+ * clover r153: r151 and r152 read cn_pnbuf *before* vn_open_auth_internal ran,
+ * but NDINIT never initializes that field -- namei's first copyin is what fills
+ * it. The saved pointer was therefore whatever the freshly allocated nameidata
+ * held (usually NULL), so both frames returned early on every open and their
+ * silence said nothing about dyld. Read the field after the call instead: by
+ * then namei has pointed it at the kernel copy of the path. nameidone() frees
+ * it only when the path was longer than ni_pathbuf (HASBUF), and dyld's two
+ * names are far shorter, so the pointer here is valid for exactly the opens
+ * this probe watches. The three readings are unchanged: did the directory
+ * open, did the file inside it open, and can this kernel read the sixteen-byte
+ * header of the file that did.
+ */
+int
+vn_open_auth(struct nameidata *ndp, int *fmodep, struct vnode_attr *vap, vnode_t authvp)
+{
+	static const char clover_cache_dir[] = "/System/Library/Caches/com.apple.dyld";
+	static const char clover_cache_file[] = "dyld_shared_cache";
+	const char *path;
+	vnode_t vp;
+	int error;
+
+	error = vn_open_auth_internal(ndp, fmodep, vap, authvp);
+	path = ndp->ni_cnd.cn_pnbuf;
+	if (path == NULL ||
+	    (strncmp(path, clover_cache_dir, sizeof(clover_cache_dir) - 1) != 0 &&
+	    strncmp(path, clover_cache_file, sizeof(clover_cache_file) - 1) != 0)) {
+		return error;
+	}
+	printf("clover r153: open %s fmode=0x%x err=%d", path,
+	    error == 0 ? *fmodep : 0, error);
+	vp = error ? NULLVP : ndp->ni_vp;
+	if (vp != NULLVP) {
+		struct mount *mp = vnode_mount(vp);
+		printf(" fl=0x%llx vt=%d fs=%s", vfs_flags(mp), vnode_vtype(vp),
+		    vfs_statfs(mp)->f_fstypename);
+	}
+	printf("\n");
+	if (vp != NULLVP && vnode_vtype(vp) == VREG) {
+		char header[17] = {0};
+		int residual = 0;
+		int read_error = vn_rdwr(UIO_READ, vp, header, 16, 0, UIO_SYSSPACE,
+		    IO_NODELOCKED | IO_NOAUTH, kauth_cred_get(), &residual,
+		    current_proc());
+		printf("clover r153: read err=%d resid=%d hdr=%s\n",
+		    read_error, residual, header);
+		clover_cache_header(vp, path);
+	}
+	return error;
+}
