+/*
+ * Round308. The reading the beat thread can give that no row inside the census burst can: what the
+ * kernel believes about its own cpus, and how far the backboardd sampler has got, both sealed on the
+ * driver relay before anything is printed. Boot 96 read `reg=` off a tee-delivered row and boot 98 lost
+ * the row entirely, so the same three numbers are now said by a producer that does not ride the console.
+ * The bound and the two flags are the ones round271 already uses; nothing here redefines them.
  */
 static void
+clover_r308_beat_row(uint64_t secs)
+{
+	extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+	char row[256];
+	uint32_t reg = 0, nstart = 0, nrun = 0;
+	int len;
+	int k;
+
+	for (k = 0; k < (MAX_CPUS < 8 ? MAX_CPUS : 8); k++) {
+		cpu_data_t *cdp = CpuDataEntries[k].cpu_data_vaddr;
+
+		if (cdp == NULL) {
+			continue;
+		}
+		reg++;
+		if (cdp->cpu_flags & StartedState) {
+			nstart++;
+		}
+		if (cdp->cpu_running) {
+			nrun++;
+		}
+	}
+
+	len = snprintf(row, sizeof(row),
+	    "clover r308: beat t=%llu target=%d ent=%u fired=%u same=%u cap=%u gone=%u"
+	    " notask=%u busy=%u reg=%u start=%u run=%u\n",
+	    (unsigned long long)secs, clover_bb_target_pid, clover_bb_enters, clover_bb_fired,
+	    clover_bb_same, clover_bb_capped, clover_bb_gone, clover_bb_notask, clover_bb_busy,
+	    reg, nstart, nrun);
+	if (len <= 0) {
+		return;
+	}
+	row[sizeof(row) - 1] = '\0';
+	clover_emmc_probe_say(row, (unsigned int)strlen(row));
+	printf("%s", row);
+}
