+/*
+ * Round229. Round228 narrowed the stall to one send whose remote owner is
+ * backboardd, and round224 already proved the shape of reading a receiver:
+ * sample that task's own threads. The difference is who is asked. A daemon
+ * can exit while this runs, so the proc reference taken here keeps the task
+ * alive across the walk and every early exit drops it; the task lock is
+ * try-locked so a wedged receiver cannot wedge the SpringBoard sampler; and
+ * the whole read is capped because the caller fires it whenever the blocked
+ * request changes. The port is read in the sender's space: the name there is
+ * a send right at the same port object, so its queue count says whether the
+ * request backboardd never answered is still sitting in its receiver.
+ */
+static void
+clover_bb_sample(int pid, task_t sb_task, mach_port_name_t name, uint64_t secs)
+{
+	static uint32_t bb_fired;
+	static uint32_t bb_beats;
+	struct proc *p;
+	extern struct proc *proc_find(int pid);
+	extern task_t proc_task(struct proc *p);
+	extern int proc_rele(struct proc *p);
+	task_t task;
+	thread_t thr;
+	char tokens[224];
+	char line[320];
+	int toff = 0;
+	int len;
+	int sc;
+	int act;
+	uint32_t n = 0;
+
+	if (pid <= 0 || sb_task == TASK_NULL) {
+		return;
+	}
+	if (bb_fired >= 24) {
+		return;
+	}
+	bb_fired++;
+	p = proc_find(pid);
+	if (p == NULL) {
+		printf("clover r229: bb t=%llu pid=%d n=%u gone\n",
+		    (unsigned long long)secs, pid, bb_fired);
+		return;
+	}
+	task = proc_task(p);
+	if (task == TASK_NULL) {
+		proc_rele(p);
+		printf("clover r229: bb t=%llu pid=%d n=%u notask\n",
+		    (unsigned long long)secs, pid, bb_fired);
+		return;
+	}
+	if (!lck_mtx_try_lock(&task->lock)) {
+		proc_rele(p);
+		printf("clover r229: bb t=%llu pid=%d n=%u busy\n",
+		    (unsigned long long)secs, pid, bb_fired);
+		return;
+	}
+	sc = task->suspend_count;
+	act = task->active;
+	tokens[0] = '\0';
+	queue_iterate(&task->threads, thr, thread_t, task_threads) {
+		arm_saved_state_t *ss;
+		uint64_t pc = 0;
+		int wrote;
+
+		if (n >= 4 || toff >= (int)sizeof(tokens) - 64) {
+			break;
+		}
+		ss = get_user_regs(thr);
+		if (ss != NULL && (uintptr_t)ss != (uintptr_t)-1) {
+			pc = (uint64_t)get_saved_state_pc(ss);
+		}
+		wrote = snprintf(tokens + toff, sizeof(tokens) - (size_t)toff,
+		    " %llx:%d:%llx:%llx:%llx",
+		    (unsigned long long)thr->thread_id, thr->state,
+		    (unsigned long long)thr->wait_event,
+		    (unsigned long long)(uintptr_t)thr->continuation,
+		    (unsigned long long)pc);
+		if (wrote <= 0 || wrote >= (int)(sizeof(tokens) - (size_t)toff)) {
+			tokens[toff] = '\0';
+			break;
+		}
+		toff += wrote;
+		n++;
+	}
+	lck_mtx_unlock(&task->lock);
+	proc_rele(p);
+	bb_beats++;
+	len = snprintf(line, sizeof(line),
+	    "clover r229: bb t=%llu pid=%d n=%u sc=%d act=%d k=%u f=%u%s\n",
+	    (unsigned long long)secs, pid, n, sc, act, bb_beats, bb_fired,
+	    tokens);
+	if (len > 0) {
+		line[sizeof(line) - 1] = '\0';
+		printf("%s", line);
+	}
+	clover_sb_port_state(sb_task, name, "bb", secs, "r229");
+}
