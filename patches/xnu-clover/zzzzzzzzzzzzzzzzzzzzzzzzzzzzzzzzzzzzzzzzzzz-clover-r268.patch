+	port = sem->port;
+	if (port == IP_NULL) {
+		return 1;
+	}
+	*otype = (uint32_t)io_otype((ipc_object_t)port);
+	if (*otype != IOT_PORT) {
+		return 1;
+	}
+	*srights = (uint32_t)port->ip_srights;
+	space = port->ip_receiver;
+	if (space == IPC_SPACE_NULL) {
+		return 1;
+	}
+	recv = space->is_task;
+	if (recv == TASK_NULL) {
+		return 1;
+	}
+	pp = (struct proc *)get_bsdtask_info(recv);
+	pname = (pp != NULL) ? proc_name_address(pp) : NULL;
+	snprintf(who, wholen, "%d:%s", task_pid(recv), pname != NULL ? pname : "?");
+	return 1;
+}
