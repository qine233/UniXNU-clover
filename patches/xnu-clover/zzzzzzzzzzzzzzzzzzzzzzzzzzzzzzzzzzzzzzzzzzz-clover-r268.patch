+static int
+clover_sema_state(thread_t thr, int *count, uint32_t *srights, uint32_t *otype,
+    char *who, size_t wholen)
+{
+	struct semaphore *sem;
+	ipc_port_t port;
+	ipc_space_t space;
+	task_t recv;
+	struct proc *pp;
+	char *pname;
