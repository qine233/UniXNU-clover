+			clover_root_phase = 3;
+		}
 		error = vfs_mountroot();
 		if (error != 0) {
 			panic("vfs_mountroot() failed.");
@@ -928,6 +932,10 @@ imageboot_mount_ramdisk(const char *path)
 	/* ... and mount it */
 	rootdev = dev;
 	mountroot = NULL;
+	{
+		extern volatile int clover_root_phase;
+		clover_root_phase = 4;
