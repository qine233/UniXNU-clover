diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 470ff47..c27ed34 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1000,10 +1000,13 @@ bsd_init(void)
 	inittodr(0);
 
 	/* Mount the root file system. */
+	extern volatile int clover_root_phase;
+	extern void clover_root_dump(void);
 	while (TRUE) {
 		int err;
 
 		bsd_init_kprintf("calling setconf\n");
+		clover_root_phase = 1;
 		setconf();
 #if CONFIG_NETBOOT
 		netboot = (mountroot == netboot_mountroot);
@@ -1031,6 +1034,47 @@ bsd_init(void)
 	}
 
 	IOSecureBSDRoot(rootdevice);
+	clover_root_phase = 10;
+
+	/*
+	 * Round 145 (clover): round144's single snapshot said the last call left
+	 * tag=3 (the ENODEV exit) with an empty list, yet the loop above broke only
+	 * on 0. One snapshot cannot say who called after the break. vfs_subr.c now
+	 * records every call in order with the phase this file set before it --
+	 * 1 loop, 2 the retry here, 3/4 imageboot.c -- and counts mount_list_add /
+	 * mount_list_remove, so the frame distinguishes "never added" (add=0) from
+	 * "added then unmounted" (add>0, del>0) from "a later call ran" (a phase
+	 * and tag after the break). The retry is kept: round144 recovered this way.
+	 */
+	if (mountlist.tqh_first == NULL) {
+		extern volatile int clover_root_probe_tag, clover_root_probe_num;
+		extern volatile int clover_root_probe_inshut, clover_root_probe_dev;
+		extern volatile unsigned long clover_root_probe_mountroot;
+		extern volatile unsigned long clover_root_probe_first;
+		int first_tag = clover_root_probe_tag;
+		int first_num = clover_root_probe_num;
+		int first_inshut = clover_root_probe_inshut;
+		int first_dev = clover_root_probe_dev;
+		unsigned long first_mountroot = clover_root_probe_mountroot;
+		unsigned long first_first = clover_root_probe_first;
+		int second;
+
+		clover_root_dump();
+		clover_root_phase = 2;
+		second = vfs_mountroot();
+
+		if (mountlist.tqh_first == NULL) {
+			clover_root_dump();
+			panic("clover r145: mountlist empty after vfs_mountroot()==0"
+			    " p1 tag=%d mr=%lx first=%lx n=%d inshut=%d dev=%d"
+			    " p2 err=%d tag=%d first=%lx n=%d",
+			    first_tag, first_mountroot, first_first, first_num,
+			    first_inshut, first_dev, second, clover_root_probe_tag,
+			    clover_root_probe_first, clover_root_probe_num);
+		}
+		printf("clover r145: root mount recovered on retry p1tag=%d p2err=%d first=%p\n",
+		    first_tag, second, (void *)mountlist.tqh_first);
+	}
 
 	mountlist.tqh_first->mnt_flag |= MNT_ROOTFS;
 
diff --git a/bsd/kern/imageboot.c b/bsd/kern/imageboot.c
