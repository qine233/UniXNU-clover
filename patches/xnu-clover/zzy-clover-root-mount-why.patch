 	err = vfs_mountroot();
 	if (err) {
 		printf("%s: failed: vfs_mountroot() = %d\n", __func__, err);
diff --git a/bsd/vfs/vfs_subr.c b/bsd/vfs/vfs_subr.c
index 57aece6..ad2bc3b 100644
--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -1206,6 +1206,77 @@ vfs_rootmountalloc(const char *fstypename, const char *devname, mount_t *mpp)
  */
 extern int (*mountroot)(void);
 
+/*
+ * Round 144 (clover): bsd_init() reached mountlist.tqh_first right after this
+ * function returned 0 for an empty list, and the deref became a data abort at
+ * FAR 0x70. Every "return 0" below happens after mount_list_add(), so the tag
+ * says which one ran and the snapshot says what the list held at that instant;
+ * bsd_init() prints both instead of taking the fault.
+ *
+ * Round 145: one snapshot cannot answer "who called again after the loop broke".
+ * Every entry of vfs_mountroot() now records the caller phase bsd_init() or
+ * imageboot() set before the call, and mount_list_add()/mount_list_remove()
+ * count their calls, so the next frame says whether the list was emptied by an
+ * unmount and which call site ran last.
+ */
+#define CLOVER_ROOT_HISTORY 8
+volatile int clover_root_probe_tag = -1;
+volatile int clover_root_probe_num = -1;
+volatile int clover_root_probe_inshut = -1;
+volatile int clover_root_probe_dev = -1;
+volatile unsigned long clover_root_probe_mountroot = 0;
+volatile unsigned long clover_root_probe_first = 0;
+volatile int clover_root_phase = 0;
+volatile int clover_mount_adds = 0;
+volatile int clover_mount_removes = 0;
+static volatile int clover_root_calls = 0;
+static volatile int clover_root_hist_phase[CLOVER_ROOT_HISTORY];
+static volatile int clover_root_hist_tag[CLOVER_ROOT_HISTORY];
+static volatile int clover_root_hist_dev[CLOVER_ROOT_HISTORY];
+static volatile int clover_root_hist_num[CLOVER_ROOT_HISTORY];
+static volatile unsigned long clover_root_hist_first[CLOVER_ROOT_HISTORY];
+
+static void
+clover_root_probe(int tag)
+{
+	int slot = clover_root_calls % CLOVER_ROOT_HISTORY;
+
+	clover_root_calls++;
+	clover_root_probe_tag = tag;
+	clover_root_probe_mountroot = (unsigned long)(uintptr_t)mountroot;
+	clover_root_probe_first = (unsigned long)(uintptr_t)mountlist.tqh_first;
+	clover_root_probe_num = nummounts;
+	clover_root_probe_inshut = get_system_inshutdown();
+	clover_root_probe_dev = (int)rootdev;
+	clover_root_hist_phase[slot] = clover_root_phase;
+	clover_root_hist_tag[slot] = tag;
+	clover_root_hist_dev[slot] = (int)rootdev;
+	clover_root_hist_num[slot] = nummounts;
+	clover_root_hist_first[slot] = (unsigned long)(uintptr_t)mountlist.tqh_first;
+}
+
+/* Called by bsd_init() on the empty-list path, before the panic, so the frame
+ * carries every call in order without a varargs line the panel would wrap away. */
+void
+clover_root_dump(void)
+{
+	int calls = clover_root_calls;
+	int shown = calls < CLOVER_ROOT_HISTORY ? calls : CLOVER_ROOT_HISTORY;
+	int base = calls - shown;
+
+	printf("clover r145 hist calls=%d add=%d del=%d now ph=%d tag=%d dev=%d n=%d first=%lx\n",
+	    calls, clover_mount_adds, clover_mount_removes, clover_root_phase,
+	    clover_root_probe_tag, clover_root_probe_dev, clover_root_probe_num,
+	    clover_root_probe_first);
+	for (int at = 0; at < shown; at++) {
+		int slot = (base + at) % CLOVER_ROOT_HISTORY;
+		printf("clover r145 call %d ph=%d tag=%d dev=%d n=%d first=%lx\n",
+		    base + at, clover_root_hist_phase[slot], clover_root_hist_tag[slot],
+		    clover_root_hist_dev[slot], clover_root_hist_num[slot],
+		    clover_root_hist_first[slot]);
+	}
+}
+
 int
 vfs_mountroot(void)
 {
@@ -1235,6 +1306,7 @@ vfs_mountroot(void)
 		error = (*mountroot)();
 
 		KDBG_RELEASE(DBG_MOUNTROOT | DBG_FUNC_END, error, 0);
+		clover_root_probe(0);
 		return error;
 	}
 	if ((error = bdevvp(rootdev, &rootvp))) {
@@ -1360,6 +1432,7 @@ vfs_mountroot(void)
 #if CONFIG_MACF
 			if ((vfs_flags(mp) & MNT_MULTILABEL) == 0) {
 				KDBG_RELEASE(DBG_MOUNTROOT | DBG_FUNC_END, 0, 2);
+				clover_root_probe(1);
 				return 0;
 			}
 
@@ -1384,6 +1457,7 @@ vfs_mountroot(void)
 			}
 #endif
 			KDBG_RELEASE(DBG_MOUNTROOT | DBG_FUNC_END, 0, 3);
+			clover_root_probe(2);
 			return 0;
 		}
 		vfs_rootmountfailed(mp);
@@ -1395,6 +1469,7 @@ fail:
 		}
 	}
 	KDBG_RELEASE(DBG_MOUNTROOT | DBG_FUNC_END, error ? error : ENODEV, 4);
+	clover_root_probe(3);
 	return ENODEV;
 }
 
@@ -7558,6 +7633,7 @@ mount_list_add(mount_t mp)
 	} else {
 		TAILQ_INSERT_TAIL(&mountlist, mp, mnt_list);
 		nummounts++;
+		clover_mount_adds++;
 		res = 0;
 	}
 	mount_list_unlock();
@@ -7571,6 +7647,7 @@ mount_list_remove(mount_t mp)
 	mount_list_lock();
 	TAILQ_REMOVE(&mountlist, mp, mnt_list);
 	nummounts--;
+	clover_mount_removes++;
 	mp->mnt_list.tqe_next = NULL;
 	mp->mnt_list.tqe_prev = NULL;
 	mount_list_unlock();
