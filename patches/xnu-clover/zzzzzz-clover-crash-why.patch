diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1845,6 +1845,38 @@
 static void
 proc_handle_critical_exit(proc_t p, int rv)
 {
+	/*
+	 * Round193. watchdogd dies with SIGTRAP on this board because the job
+	 * matches an IOWatchdog service that does not exist, and its job plist
+	 * sets PanicOnCrash/PanicOnConsecutiveCrash, so XNU turns the third
+	 * death into a panic. panic_on_crash_disabled=1 in the payload is what
+	 * keeps the boot alive; this line says which decision inputs were live
+	 * when the exit reached this function, so the frame proves the
+	 * suppression ran on the path we think it did. */
+	{
+		static uint32_t clover_crit_prints;
+
+		if (clover_crit_prints < 64) {
+			uint64_t clover_crit_now = mach_continuous_time();
+			os_reason_t clover_crit_reason = p->p_exit_reason;
+			int clover_crit_fatal = (clover_crit_reason != OS_REASON_NULL) ?
+			    (int)_proc_is_fatal_reason(clover_crit_reason) : -1;
+			int clover_crit_sigcrash = (WIFSIGNALED(rv) &&
+			    clover_crit_reason != OS_REASON_NULL &&
+			    clover_crit_reason->osr_namespace == OS_REASON_SIGNAL) ?
+			    (int)_proc_is_crashing_signal((int)clover_crit_reason->osr_code) : -1;
+
+			clover_crit_prints++;
+			printf("clover r193: crit pid=%d comm=%s rv=0x%x sig=%d fatal=%d sigcrash=%d crashbits=0x%x spawnfail=%d deadline=%llu now=%llu\n",
+			    proc_getpid(p), p->p_comm, rv,
+			    WIFSIGNALED(rv) ? WTERMSIG(rv) : -1,
+			    clover_crit_fatal, clover_crit_sigcrash,
+			    p->p_crash_behavior, p->p_posix_spawn_failed,
+			    (unsigned long long)p->p_crash_behavior_deadline,
+			    (unsigned long long)clover_crit_now);
+		}
+	}
+
 	if (!proc_should_trigger_panic(p, rv)) {
 		// No panic, bail out
 		return;
@@ -1926,6 +1958,44 @@
 	boot_progress_exit(proc_getpid(p),p->p_name,rv,
 	    p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
 	    p->p_exit_reason ? p->p_exit_reason->osr_code : 0);
+
+	/*
+	 * Round196. usermanagerd answers with SIGABRT and the reason buffer
+	 * carries the abort message, but the string only reaches the console
+	 * through the critical path, which these processes never take. Print it
+	 * here instead, three exits per command name and eight names, so a
+	 * single looping daemon cannot flush the ring on its own.
+	 */
+	if (p->p_exit_reason != OS_REASON_NULL &&
+	    p->p_exit_reason->osr_namespace == OS_REASON_SIGNAL) {
+		static char clover_sig_comm[8][17];
+		static uint32_t clover_sig_count[8];
+		static uint32_t clover_sig_used;
+		uint32_t clover_sig_slot = 8;
+		uint32_t clover_sig_i;
+
+		for (clover_sig_i = 0; clover_sig_i < clover_sig_used; clover_sig_i++) {
+			if (strncmp(clover_sig_comm[clover_sig_i], p->p_comm, 16) == 0) {
+				clover_sig_slot = clover_sig_i;
+				break;
+			}
+		}
+		if (clover_sig_slot == 8 && clover_sig_used < 8) {
+			clover_sig_slot = clover_sig_used++;
+			strlcpy(clover_sig_comm[clover_sig_slot], p->p_comm, 17);
+		}
+		if (clover_sig_slot < 8 && clover_sig_count[clover_sig_slot] < 3) {
+			const char *clover_sig_desc =
+			    exit_reason_get_string_desc(p->p_exit_reason);
+
+			clover_sig_count[clover_sig_slot]++;
+			printf("clover r196: sig pid=%d comm=%s sig=%d n=%u desc=%s\n",
+			    proc_getpid(p), p->p_comm,
+			    (int)p->p_exit_reason->osr_code,
+			    clover_sig_count[clover_sig_slot],
+			    clover_sig_desc ? clover_sig_desc : "none");
+		}
+	}
 
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
diff --git a/bsd/kern/kern_sig.c b/bsd/kern/kern_sig.c
--- a/bsd/kern/kern_sig.c
+++ b/bsd/kern/kern_sig.c
@@ -2057,6 +2057,92 @@
 		panic("psignal: bad signal number %d", signum);
 	}
 
+	/*
+	 * Round207. Round206 left SpringBoard dead at 417.5 s with rv=0x9 and a
+	 * reason the kernel builds itself on the default-kill path, so the exit
+	 * says nothing about who sent it. Print the receiver and the sender for
+	 * the signals that end a job: current_proc() is the sender for kill(2),
+	 * kernproc (pid 0) for a kernel thread (jetsam, task_terminate), and cs
+	 * says whether the code-signing path flagged the process. ra names the
+	 * psignal wrapper (or the caller it was inlined into); anchor is this
+	 * function's link-time address, so the host recovers the slide.
+	 */
+	if ((signum == SIGKILL || signum == SIGTERM) && (p != PROC_NULL)) {
+		static char clover_kill_comm[8][17];
+		static uint32_t clover_kill_count[8];
+		static uint32_t clover_kill_used;
+		static uint32_t clover_kill_prints;
+		static uint32_t clover_r208_prints;
+		proc_t clover_kill_sender = current_proc();
+		uint32_t clover_kill_slot = 8;
+		uint32_t clover_kill_i;
+
+		for (clover_kill_i = 0; clover_kill_i < clover_kill_used; clover_kill_i++) {
+			if (strncmp(clover_kill_comm[clover_kill_i], p->p_comm, 16) == 0) {
+				clover_kill_slot = clover_kill_i;
+				break;
+			}
+		}
+		if (clover_kill_slot == 8 && clover_kill_used < 8) {
+			clover_kill_slot = clover_kill_used++;
+			strlcpy(clover_kill_comm[clover_kill_slot], p->p_comm, 17);
+		}
+		if (clover_kill_slot < 8 && clover_kill_count[clover_kill_slot] < 4 &&
+		    clover_kill_prints < 40) {
+			clover_kill_count[clover_kill_slot]++;
+			clover_kill_prints++;
+			printf("clover r207: killsig pid=%d comm=%s ppid=%d sig=%d spid=%d scomm=%s ns=%d code=0x%llx cs=0x%x ra=%016llx anchor=%016llx\n",
+			    proc_getpid(p), p->p_comm, p->p_ppid, signum,
+			    proc_getpid(clover_kill_sender), clover_kill_sender->p_comm,
+			    (signal_reason != NULL) ? signal_reason->osr_namespace : -1,
+			    (unsigned long long)((signal_reason != NULL) ? signal_reason->osr_code : 0ULL),
+			    (unsigned int)proc_getcsflags(p),
+			    (unsigned long long)(uintptr_t)__builtin_return_address(0),
+			    (unsigned long long)(uintptr_t)&psignal_internal);
+		}
+
+		/*
+		 * Round208. Round207 named the sender; this says where in the
+		 * sender the kill was issued, and where every SpringBoard
+		 * thread was when it arrived. The sender's user PC plus the
+		 * four bytes at it locate the call site in backboardd without
+		 * following chained fixups on the host; a collective-watchdog
+		 * kill usually means the main thread is stuck, so the receiver
+		 * side matters more than the sender side.
+		 */
+		/*
+		 * Round208. Round207 named the sender; this says where in the
+		 * sender the kill was issued. The sender's user pc plus the four
+		 * bytes at it locate the call site in backboardd without following
+		 * chained fixups on the host. The receiver side -- every
+		 * SpringBoard thread at the moment the watchdog fires -- cannot be
+		 * read here: bsd is built without MACH_KERNEL_PRIVATE, so struct
+		 * task and struct thread are opaque and get_user_regs() is
+		 * invisible. That half lives in osfmk/kern/task.c.
+		 */
+		if (signum == SIGKILL && clover_r208_prints < 64) {
+			extern uint64_t clover_sender_upc(void);
+			extern uint32_t clover_task_threads(task_t task, uint32_t budget);
+			uint64_t clover_r208_upc = clover_sender_upc();
+			uint32_t clover_r208_uinsn = 0;
+
+			if (clover_r208_upc != 0 &&
+			    copyin((user_addr_t)clover_r208_upc, &clover_r208_uinsn,
+			    sizeof(clover_r208_uinsn)) != 0) {
+				clover_r208_uinsn = 0;
+			}
+			clover_r208_prints++;
+			printf("clover r208: sender upc=%016llx uinsn=%08x spid=%d scomm=%s\n",
+			    (unsigned long long)clover_r208_upc, clover_r208_uinsn,
+			    proc_getpid(clover_kill_sender), clover_kill_sender->p_comm);
+
+			if (strncmp(p->p_comm, "SpringBoard", 16) == 0) {
+				clover_r208_prints += clover_task_threads(proc_task(p),
+				    (clover_r208_prints < 64) ? 64 - clover_r208_prints : 0);
+			}
+		}
+	}
+
 	mask = sigmask(signum);
 	prop = sigprop[signum];
 
diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -129,6 +129,11 @@
 #include <kern/policy_internal.h>
 #include <kern/restartable.h>
 #include <kern/ipc_kobject.h>
+
+#if defined(__arm64__)
+#include <arm/thread.h>
+#include <mach/machine/thread_status.h>
+#endif
 
 #include <corpses/task_corpse.h>
 #if CONFIG_TELEMETRY
@@ -10285,3 +10290,68 @@
 	char *name = proc_best_name(task_get_proc_raw(task));
 	strlcpy(buf, name, size);
 }
+
+
+#if defined(__arm64__)
+/*
+ * Round208. bsd/kern is built without MACH_KERNEL_PRIVATE, so the signal
+ * path there cannot see a thread's saved registers or the internal task
+ * fields. These two readings happen here, where both are in scope.
+ */
+uint64_t
+clover_sender_upc(void)
+{
+	thread_t thr = current_thread();
+	arm_saved_state_t *ss;
+
+	if (thr == THREAD_NULL) {
+		return 0;
+	}
+	ss = get_user_regs(thr);
+	return (ss != NULL) ? (uint64_t)get_saved_state_pc(ss) : 0;
+}
+
+uint32_t
+clover_task_threads(task_t task, uint32_t budget)
+{
+	struct {
+		uint64_t tid;
+		uint64_t pc;
+		uint32_t cpsr;
+		int state;
+		uint64_t wait;
+	} snap[10];
+	thread_t thr;
+	uint32_t n = 0;
+	uint32_t i;
+
+	if (task == TASK_NULL || budget == 0) {
+		return 0;
+	}
+	/* Snapshot under the lock and print after it: the console can block
+	 * and nothing else should wait on task_lock behind a print. */
+	task_lock(task);
+	queue_iterate(&task->threads, thr, thread_t, task_threads) {
+		arm_saved_state_t *ss;
+
+		if (n >= 10 || n >= budget) {
+			break;
+		}
+		ss = get_user_regs(thr);
+		snap[n].tid = thr->thread_id;
+		snap[n].pc = (ss != NULL) ? (uint64_t)get_saved_state_pc(ss) : 0;
+		snap[n].cpsr = (ss != NULL) ? (uint32_t)get_saved_state_cpsr(ss) : 0;
+		snap[n].state = thr->state;
+		snap[n].wait = (uint64_t)thr->wait_event;
+		n++;
+	}
+	task_unlock(task);
+	for (i = 0; i < n; i++) {
+		printf("clover r208: sbthr n=%u tid=0x%llx pc=%016llx cpsr=%08x state=%d wait=%016llx\n",
+		    i + 1, (unsigned long long)snap[i].tid,
+		    (unsigned long long)snap[i].pc, snap[i].cpsr, snap[i].state,
+		    (unsigned long long)snap[i].wait);
+	}
+	return n;
+}
+#endif /* __arm64__ */
