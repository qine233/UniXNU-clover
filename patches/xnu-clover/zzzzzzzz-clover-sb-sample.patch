index 9298c33..fbfa2b8 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -234,6 +234,21 @@ clover_sys_why_mach(int trap_no, arm_saved_state_t *state)
 {
 	struct proc *p = get_bsdthreadtask_info(current_thread());
 
+	/* Clover (round217): the sample that describes the stop has to be taken
+	 * before the kill, so every mach-trap entry is the clock. SpringBoard's
+	 * own entry names the task once; any later entry, from any process,
+	 * re-reads its threads eight seconds apart. Round216 read the same
+	 * threads from the signal path and found them already torn down. */
+	if (p != NULL) {
+		extern void clover_sb_note_current(void);
+		extern void clover_sb_sample(void);
+
+		if (strncmp(p->p_comm, "SpringBoard", 16) == 0) {
+			clover_sb_note_current();
+		}
+		clover_sb_sample();
+	}
+
 	if (p == NULL || !clover_sys_why_watched(p->p_comm)) {
 		return;
 	}
