+/*
+ * Round218. The same delivery, two more readings of the sender. ulr is the
+ * stub's own return address; ufp hands the user frame pointer and stack
+ * pointer to bsd, where copyin is declared, so the kill call site can be
+ * walked on the sender's stack instead of only read at the pc.
+ */
+uint64_t
+clover_sender_ulr(void)
+{
+	thread_t thr = current_thread();
+	arm_saved_state_t *ss;
+
+	if (thr == THREAD_NULL) {
+		return 0;
+	}
+	ss = get_user_regs(thr);
+	return (ss != NULL) ? (uint64_t)get_saved_state_lr(ss) : 0;
+}
+
+uint32_t
+clover_sender_ufp(uint64_t *fp, uint64_t *sp)
+{
+	thread_t thr = current_thread();
+	arm_saved_state_t *ss;
+
+	if (thr == THREAD_NULL || fp == NULL || sp == NULL) {
+		return 0;
+	}
+	ss = get_user_regs(thr);
+	if (ss == NULL) {
+		return 0;
+	}
+	*fp = (uint64_t)get_saved_state_fp(ss);
+	*sp = (uint64_t)get_saved_state_sp(ss);
+	return 1;
+}
+
+/*
+ * Round218. Walk a user stack the same way the kernel walk goes, with the
+ * stack pointer as the floor and a fixed ceiling above it: a chain that
+ * leaves that window is a stale or corrupt fp, not a frame. copyin comes in
+ * as the copyio.h macro, so it is called through the three-argument form.
+ */
+
+static uint32_t
+clover_user_fp_walk(uint64_t fp, uint64_t sp, uint64_t *frames, uint32_t frames_max)
+{
+	uint32_t i = 0;
+	uint64_t limit;
+
+	if (sp == 0) {
+		return 0;
+	}
+	limit = sp + 0x40000;
+	while (i < frames_max && fp != 0 && (fp & 7) == 0 &&
+	    fp >= sp && fp < limit) {
+		uint64_t pair[2];
+
+		if (copyin((user_addr_t)fp, pair, sizeof(pair)) != 0) {
+			break;
+		}
+		if (pair[1] == 0) {
+			break;
+		}
+		frames[i++] = pair[1];
+		if (pair[0] <= fp) {
+			break;
+		}
+		fp = pair[0];
+	}
+	return i;
+}
