+/*
+ * Round217. The signal path can only read the task after it was killed, and
+ * round216 showed what that costs: the walker then waited 39 s on the dying
+ * task's own lock, and the saved state it finally read had already been
+ * released. So the reading is taken before the kill instead: every SpringBoard
+ * thread is sampled from whichever process next enters a mach trap, at most
+ * once every eight seconds, and only when the set of thread states changed --
+ * or once every two minutes as a heartbeat. A line that repeats is not a
+ * reading; the line that changes is the moment the process stopped moving,
+ * and its t= names when. The volume stays small enough that the tee's
+ * per-class budget never has to drop the last one, which is the one that
+ * describes the stop.
+ *
+ * The task is captured on SpringBoard's own trap entry, where its task cannot
+ * be deallocating, and one reference is held for the life of the boot: this is
+ * a diagnostic build, and the reference is what lets a sample taken after the
+ * kill read a live object instead of a freed one.
+ */
+static task_t clover_sb_task;
+static volatile uint32_t clover_sb_ready;
+static uint64_t clover_sb_last_secs;
+static uint64_t clover_sb_heartbeat;
+static uint32_t clover_sb_changes;
+static char clover_sb_last[256];
+static char clover_sb_last_m2[1024];
+
+void
+clover_sb_note_current(void)
+{
+	if (__atomic_load_n(&clover_sb_ready, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	task_reference(current_task());
+	clover_sb_task = current_task();
+	__atomic_store_n(&clover_sb_ready, 1, __ATOMIC_RELEASE);
+}
+
+static uint64_t
+clover_now_seconds(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000000ULL;
+}
+
+/*
+ * Round220. A port name in the descriptor says nothing by itself. Translate it
+ * in the sampled task's own space and, when it is a port whose receive right
+ * lives in some space, read that space's is_task: that is the task serving the
+ * name. ipc_object_translate returns the object locked and without a reference
+ * (and trips no guard on a wrong right), so the task gets its own reference
+ * while the port lock is held, and the pid and name are read after unlocking --
+ * task_pid walks the audit token and takes its own locks.
+ */
+static void
+clover_sb_port_owner(task_t task, mach_port_name_t name, char *out, size_t outlen)
+{
+	ipc_space_t space;
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	task_t owner = TASK_NULL;
+	struct proc *proc;
+	char *pname;
+	char comm[16];
+	kern_return_t kr;
+
+	out[0] = '\0';
+	if (name == MACH_PORT_NULL) {
+		return;
+	}
+	space = task->itk_space;
+	if (space == IPC_SPACE_NULL) {
+		return;
+	}
+	kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_SEND, &obj);
+	if (kr != KERN_SUCCESS) {
+		kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_RECEIVE,
+		    &obj);
+	}
+	if (kr != KERN_SUCCESS) {
+		return;
+	}
+	if (io_otype(obj) == IOT_PORT) {
+		ipc_space_t recv = ip_get_receiver((ipc_port_t)obj);
+
+		if (recv != IPC_SPACE_NULL && recv->is_task != TASK_NULL) {
+			owner = recv->is_task;
+			task_reference(owner);
+		}
+	}
+	io_unlock(obj);
+	if (owner == TASK_NULL) {
+		return;
+	}
+	comm[0] = '\0';
+	proc = (struct proc *)get_bsdtask_info(owner);
+	pname = (proc != NULL) ? proc_name_address(proc) : NULL;
+	if (pname != NULL) {
+		strlcpy(comm, pname, sizeof(comm));
+	}
+	snprintf(out, outlen, "%d:%s", task_pid(owner), comm);
+	task_deallocate(owner);
+}
+
+/*
+ * One line carries every thread: tid:state:wait:continuation:pc per thread.
+ * The continuation is what names a blocked thread's wait -- wait_event is zero
+ * for a thread parked on a mach_msg wait, exactly the case this is read for --
+ * and pc says where in userspace it was when the sample was taken. The line is
+ * kept under the tee's 320-byte record: five threads at roughly fifty bytes a
+ * thread, so the driver never has to truncate the thread that stopped.
+ */
+void
+clover_sb_sample(void)
+{
+	task_t task;
+	thread_t thr;
+	uint64_t secs;
+	char tokens[256];
+	char line[320];
+	int toff = 0;
+	int len;
+	int pid;
+	uint64_t tids[5];
+	uint64_t x16s[5];
+	uint64_t fps[5];
+	uint64_t sps[5];
+	uint64_t m2[5][8];
+	uint32_t n = 0;
+	uint32_t i;
+	uint32_t j;
+	uint32_t changed;
+	uint32_t heartbeat;
+
+	if (!__atomic_load_n(&clover_sb_ready, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	task = clover_sb_task;
+	if (task == TASK_NULL) {
+		return;
+	}
+	/* Round218 reads each thread's user stack, and copyin uses the map of
+	 * whoever is trapping, so a sample is only taken when SpringBoard
+	 * itself is the current task. */
+	if (current_task() != task) {
+		return;
+	}
+	secs = clover_now_seconds();
+	if (secs < clover_sb_last_secs + 8) {
+		return;
+	}
+	clover_sb_last_secs = secs;
+	if (!lck_mtx_try_lock(&task->lock)) {
+		if (secs >= clover_sb_heartbeat + 120) {
+			clover_sb_heartbeat = secs;
+			printf("clover r217: sbbusy t=%llu\n",
+			    (unsigned long long)secs);
+		}
+		return;
+	}
+	pid = task_pid(task);
+	tokens[0] = '\0';
+	queue_iterate(&task->threads, thr, thread_t, task_threads) {
+		arm_saved_state_t *ss;
+		uint64_t pc = 0;
+		int wrote;
+
+		if (n >= 5 || toff >= (int)sizeof(tokens) - 64) {
+			break;
+		}
+		ss = get_user_regs(thr);
+		tids[n] = thr->thread_id;
+		x16s[n] = 0;
+		fps[n] = 0;
+		sps[n] = 0;
+		for (j = 0; j < 8; j++) {
+			m2[n][j] = 0;
+		}
+		if (ss != NULL && (uintptr_t)ss != (uintptr_t)-1) {
+			pc = (uint64_t)get_saved_state_pc(ss);
+			if (!is_saved_state32(ss)) {
+				x16s[n] = (uint64_t)saved_state64(ss)->x[16];
+				for (j = 0; j < 8; j++) {
+					m2[n][j] = (uint64_t)saved_state64(ss)->x[j];
+				}
+			}
+			fps[n] = (uint64_t)get_saved_state_fp(ss);
+			sps[n] = (uint64_t)get_saved_state_sp(ss);
+		}
+		wrote = snprintf(tokens + toff, sizeof(tokens) - (size_t)toff,
+		    " %llx:%d:%llx:%llx:%llx",
+		    (unsigned long long)thr->thread_id, thr->state,
+		    (unsigned long long)thr->wait_event,
+		    (unsigned long long)(uintptr_t)thr->continuation,
+		    (unsigned long long)pc);
+		if (wrote <= 0 || wrote >= (int)(sizeof(tokens) - (size_t)toff)) {
+			toff = (int)sizeof(tokens) - 1;
+			tokens[toff] = '\0';
+			break;
+		}
+		toff += wrote;
+		n++;
+	}
+	lck_mtx_unlock(&task->lock);
+
+	changed = (strcmp(tokens, clover_sb_last) != 0);
+	heartbeat = (secs >= clover_sb_heartbeat + 120);
+	if (!changed && !heartbeat) {
+		return;
+	}
+	if (changed && clover_sb_changes >= 32) {
+		/* The change budget is spent; the heartbeat carries the rest. */
+		if (!heartbeat) {
+			return;
+		}
+		changed = 0;
+	}
+	clover_sb_heartbeat = secs;
+	if (changed) {
+		clover_sb_changes++;
+		strlcpy(clover_sb_last, tokens, sizeof(clover_sb_last));
+	}
+	len = snprintf(line, sizeof(line),
+	    "clover r217: sbs t=%llu pid=%d n=%u c=%u%s%s\n",
+	    (unsigned long long)secs, pid, n, clover_sb_changes,
+	    changed ? " chg" : "", tokens);
+	if (len > 0) {
+		line[sizeof(line) - 1] = '\0';
+		printf("%s", line);
+	}
+	for (i = 0; i < n; i++) {
+		uint64_t frames[4] = { 0, 0, 0, 0 };
+		uint32_t kn;
+		char extra[224];
+		int elen;
+
+		kn = clover_user_fp_walk(fps[i], sps[i], frames, 4);
+		elen = snprintf(extra, sizeof(extra),
+		    "clover r218: sbpc t=%llu tid=0x%llx x16=%llx n=%u f0=%llx f1=%llx f2=%llx f3=%llx\n",
+		    (unsigned long long)secs, (unsigned long long)tids[i],
+		    (unsigned long long)x16s[i], kn,
+		    (unsigned long long)frames[0], (unsigned long long)frames[1],
+		    (unsigned long long)frames[2], (unsigned long long)frames[3]);
+		if (elen > 0) {
+			extra[sizeof(extra) - 1] = '\0';
+			printf("%s", extra);
+		}
+	}
+
+	/*
+	 * Round220. Round219 read these words one register off. mach_msg2_trap
+	 * takes data in x0, option64 in x1, bits|send_size<<32 in x2,
+	 * remote|local<<32 in x3, voucher|msgh_id<<32 in x4,
+	 * desc_count|rcv_name<<32 in x5, rcv_size|priority<<32 in x6 and the
+	 * timeout in x7 (osfmk/mach/mach_traps.h). The numbers it printed were
+	 * right; the labels were not. And a name says nothing by itself, so each
+	 * one is translated to the task whose receive right sits behind it: that
+	 * is what turns "waiting on 0x3003" into "waiting on pid 58". The
+	 * translation only runs when the numeric signature changes.
+	 */
+	{
+		char m2sig[1024];
+		char m2lines[2048];
+		uint32_t pick[5];
+		uint32_t mhdr[5][6];
+		uint32_t npick = 0;
+		int soff = 0;
+		int loff = 0;
+
+		m2sig[0] = '\0';
+		m2lines[0] = '\0';
+		for (i = 0; i < n; i++) {
+			uint64_t *r = m2[i];
+			uint32_t hdr[6] = { 0, 0, 0, 0, 0, 0 };
+			int sw;
+
+			if (x16s[i] != (uint64_t)-47 || r[0] == 0) {
+				continue;
+			}
+			if (npick >= 5) {
+				break;
+			}
+			(void)copyin((user_addr_t)r[0], hdr, sizeof(hdr));
+			sw = snprintf(m2sig + soff, sizeof(m2sig) - (size_t)soff,
+			    " %llx:%llx:%x.%x.%x.%x.%x.%x.%x.%x.%x.%x.%x.%llx"
+			    ".%x.%x.%x.%x.%x.%x",
+			    (unsigned long long)tids[i], (unsigned long long)r[1],
+			    (uint32_t)r[2], (uint32_t)(r[2] >> 32),
+			    (uint32_t)r[3], (uint32_t)(r[3] >> 32),
+			    (uint32_t)r[4], (uint32_t)(r[4] >> 32),
+			    (uint32_t)r[5], (uint32_t)(r[5] >> 32),
+			    (uint32_t)r[6], (uint32_t)(r[6] >> 32),
+			    (unsigned long long)r[7],
+			    hdr[0], hdr[1], hdr[2], hdr[3], hdr[4], hdr[5]);
+			if (sw <= 0 || sw >= (int)(sizeof(m2sig) - (size_t)soff)) {
+				break;
+			}
+			soff += sw;
+			pick[npick] = i;
+			for (j = 0; j < 6; j++) {
+				mhdr[npick][j] = hdr[j];
+			}
+			npick++;
+		}
+		if (npick > 0 && strcmp(m2sig, clover_sb_last_m2) != 0) {
+			strlcpy(clover_sb_last_m2, m2sig, sizeof(clover_sb_last_m2));
+			for (j = 0; j < npick && loff < (int)sizeof(m2lines) - 320;
+			    j++) {
+				uint64_t *r = m2[pick[j]];
+				char ro[24], lo[24], ho[24];
+				int lw;
+
+				clover_sb_port_owner(task,
+				    (mach_port_name_t)(uint32_t)r[3], ro, sizeof(ro));
+				clover_sb_port_owner(task,
+				    (mach_port_name_t)(uint32_t)(r[3] >> 32), lo,
+				    sizeof(lo));
+				clover_sb_port_owner(task,
+				    (mach_port_name_t)mhdr[j][2], ho, sizeof(ho));
+				lw = snprintf(m2lines + loff,
+				    sizeof(m2lines) - (size_t)loff,
+				    "clover r220: sbm2 t=%llu tid=0x%llx op=%llx"
+				    " b=%x sz=%x rem=%x loc=%x vou=%x id=%x dc=%x"
+				    " rn=%x rs=%x pr=%x to=%llx ro=%s lo=%s"
+				    " h=%x.%x.%x.%x.%x.%x ho=%s\n",
+				    (unsigned long long)secs,
+				    (unsigned long long)tids[pick[j]],
+				    (unsigned long long)r[1],
+				    (uint32_t)r[2], (uint32_t)(r[2] >> 32),
+				    (uint32_t)r[3], (uint32_t)(r[3] >> 32),
+				    (uint32_t)r[4], (uint32_t)(r[4] >> 32),
+				    (uint32_t)r[5], (uint32_t)(r[5] >> 32),
+				    (uint32_t)r[6], (uint32_t)(r[6] >> 32),
+				    (unsigned long long)r[7],
+				    ro[0] ? ro : "-", lo[0] ? lo : "-",
+				    mhdr[j][0], mhdr[j][1], mhdr[j][2],
+				    mhdr[j][3], mhdr[j][4], mhdr[j][5],
+				    ho[0] ? ho : "-");
+				if (lw <= 0 ||
+				    lw >= (int)(sizeof(m2lines) - (size_t)loff)) {
+					break;
+				}
+				loff += lw;
+			}
+			if (loff > 0) {
+				m2lines[sizeof(m2lines) - 1] = '\0';
+				printf("%s", m2lines);
+			}
+		}
+	}
