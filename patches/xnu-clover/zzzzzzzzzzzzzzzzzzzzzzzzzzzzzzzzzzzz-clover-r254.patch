+static bool
+clover_mg_same(const char *a, const char *b)
+{
+	while (a[0] != '\0' && b[0] != '\0') {
+		if (a[0] != b[0]) {
+			return false;
+		}
+		a++;
+		b++;
+	}
+	return a[0] == b[0];
