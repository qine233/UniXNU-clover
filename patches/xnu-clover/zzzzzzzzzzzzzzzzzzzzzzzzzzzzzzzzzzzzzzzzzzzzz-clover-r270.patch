+/*
+ * Round270. The board's own CPU driver already keeps this accounting, and it is all inside an
+ * extern "C" block (drivers/ArmCpu/ArmCpu.cpp:32), so the census can read it without any new
+ * driver interface. What is being asked is narrower than "is the GIC broken": boot 56 showed
+ * com.apple.datamigrator with eight threads, all asleep, none runnable, and the one thread that owes
+ * a semaphore's signal is the same thread that owns the workloop its five workers sleep on. That is a
+ * queue that got work and never woke anybody, and on ARM the wake-up of a sleeping thread on another
+ * core is an IPI -- which this board's driver comments already distrust ("ICC_SGI1R_EL1 generates
+ * nothing on this board"). sent vs recv says whether the kernel asked and nobody arrived; the
+ * per-core array says whether one specific core ever receives one at all.
+ */
+extern volatile uint64_t armcpu_ipi_sent;
+extern volatile uint64_t armcpu_ipi_interrupts;
+extern volatile uint64_t armcpu_timer_interrupts;
+extern volatile uint32_t armcpu_core_sgi[8];
+extern volatile uint32_t armcpu_core_timer[8];
