+/* Round252. Is this pid one of the processes whose button questions we are already tracking? */
+static const struct clover_mg_who *
+clover_mg_asked(int pid)
+{
+	uint32_t i;
+
+	for (i = 0; i < clover_mg_whos; i++) {
+		if (clover_mg_who[i].pid == pid) {
+			return &clover_mg_who[i];
+		}
+	}
+	return NULL;
+}
