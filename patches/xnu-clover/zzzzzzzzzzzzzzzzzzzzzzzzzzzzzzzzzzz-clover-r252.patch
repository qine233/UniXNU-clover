+/* Round252. A question this board cannot answer, said once per ring slot. kind is "key" for a
+ * property that is not there and "path" for a registry path that does not resolve. */
+static void
+clover_mg_miss(const char *kind, const char *what)
+{
+	char        *row;
+	uint64_t     ns = 0;
+	int          pid;
+	const struct clover_mg_who *asker;
+
+	pid = proc_selfpid();
+	asker = clover_mg_asked(pid);
+	if (asker == NULL) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	row = clover_mg_miss_rows[clover_mg_miss_notes % CLOVER_MG_MISSES];
+	snprintf(row, CLOVER_MG_LINE, "t=%llu %s pid=%d comm=%.20s missing=%.48s",
+	    (unsigned long long) (ns / 1000000000ULL), kind, pid, asker->name, what);
+	if (clover_mg_miss_notes < CLOVER_MG_MISSES) {
+		printf("clover r252: %s\n", row);
+	}
+	clover_mg_miss_notes++;
+}
