+/*
+ * Round359. Boot 138's backboardd waited on two port sets (4103 with three members, 6203 with
+ * seven) instead of the leaf port r358 went looking for, so hoprr never ran. r347 resolves every
+ * member with a send right and names who can post to it; what it never says is whose receive right
+ * each member is. This reads ip_get_receiver/ip_get_receiver_name on the member the walk already
+ * holds under its own reference (r220's lock discipline, the same legs as r358) and prints
+ * clover r359: psmrcv, one row per member with sr>0. A member whose receiver is not the waiting
+ * task means the set crosses task boundaries; a member whose receiver is the waiter and whose
+ * senders were named in the same fire is the ring drawn as one row.
+ */
+static void __attribute__((noinline))
+clover_bb_member_receiver(ipc_port_t port, int pid, int hop, uint32_t i,
+    mach_port_name_t name, uint32_t sr, uint32_t ms, uint64_t secs)
+{
+	extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+	extern struct proc *proc_find(int pid);
+	extern task_t proc_task(struct proc *p);
+	extern int proc_rele(struct proc *p);
+	ipc_space_t recv;
+	task_t owner = TASK_NULL;
+	uint32_t rnm = 0;
+	int rstate = -1;
+	int rpid = -3;
+	int pid2;
+	struct proc *pp;
+	char rc[16];
+	char row[220];
+	int len;
+
+	rc[0] = '\0';
+	io_lock(port);
+	recv = ip_get_receiver(port);
+	rnm = (uint32_t)ip_get_receiver_name(port);
+	if (recv == IPC_SPACE_NULL) {
+		rstate = 2;
+	} else if (recv->is_task == TASK_NULL) {
+		rstate = 1;
+	} else {
+		owner = recv->is_task;
+		task_reference(owner);
+		rstate = 0;
+	}
+	io_unlock(port);
+	if (owner != TASK_NULL) {
+		for (pid2 = 1; pid2 <= CLOVER_BB_SEMA_PROBE; pid2++) {
+			pp = proc_find(pid2);
+			if (pp == NULL) {
+				continue;
+			}
+			if (proc_task(pp) == owner) {
+				rpid = pid2;
+				if (proc_name_address(pp) != NULL) {
+					strlcpy(rc, proc_name_address(pp), sizeof(rc));
+				}
+				proc_rele(pp);
+				break;
+			}
+			proc_rele(pp);
+		}
+		task_deallocate(owner);
+	} else if (rstate == 1) {
+		rpid = -1;
+		strlcpy(rc, "kspace", sizeof(rc));
+	} else if (rstate == 2) {
+		rpid = -2;
+		strlcpy(rc, "none", sizeof(rc));
+	}
+	len = snprintf(row, sizeof(row),
+	    "clover r359: psmrcv t=%llu pid=%d hop=%d i=%u nm=%x sr=%u ms=%u rnm=%x"
+	    " rstate=%d rpid=%d c=%s\n",
+	    (unsigned long long)secs, pid, hop, i, name, sr, ms, rnm, rstate, rpid, rc);
+	if (len > 0) {
+		row[sizeof(row) - 1] = '\0';
+		clover_emmc_probe_say(row, (unsigned int)strlen(row));
+		printf("%s", row);
+	}
+}
