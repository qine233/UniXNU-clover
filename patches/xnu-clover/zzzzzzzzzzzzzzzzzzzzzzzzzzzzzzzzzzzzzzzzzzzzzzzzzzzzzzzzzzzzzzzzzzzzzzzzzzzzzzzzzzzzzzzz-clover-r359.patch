 			clover_emmc_probe_say(row, (unsigned int)strlen(row));
 			printf("%s", row);
 		}
+		/*
+		 * Round359. r347 named who can post to this member; this names whose port it is. The
+		 * member is already held by the reference the set walk took, so no second translate.
+		 */
+		clover_bb_member_receiver(snap.ports[i], pid, hop, i,
