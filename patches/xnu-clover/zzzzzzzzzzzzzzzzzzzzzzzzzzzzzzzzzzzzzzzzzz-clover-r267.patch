 /*
+ * Round267. The kernel already knows who owes every wait: the stackshot path answers it with
+ * stackshot_thread_wait_owner_info (osfmk/kern/kern_stackshot.c), which switches on
+ * thread->block_hint and calls the kdp_*_find_owner helpers. Those helpers are extern here
+ * through <kern/block_hint.h> (pulled in by <kern/thread.h>) and only the dispatcher is static,
+ * so the census asks them itself instead of guessing from a wait address. Three kinds are asked,
+ * and each is a plain read of a kernel object -- no lock, no user memory:
+ *   kThreadWaitWorkloopSyncWait  owner = the tid of kqwl->kqwl_owner (or the bound request
+ *                                thread, or STACKSHOT_WAITOWNER_THREQUESTED), context = the
+ *                                workloop's kqwl_dynamicid
+ *   kThreadWaitSemaphore         owner = the pid of sem->owner's task, context = the kernel
+ *                                address of sem->port
+ *   kThreadWaitUserLock          owner = the tid of ull->ull_owner, context = the user address
+ *                                ull was taken on
+ * The hint is reported for every waiter whether or not it was asked: KernelMutex, the port
+ * receive/send kinds and the pthread kinds are deliberately not asked (the mutex path resolves
+ * its owner through ctid_get_thread, which takes a reference this census would never drop), so
+ * ak=0 means "the kernel has a name for this, we did not go and read it" and is a different
+ * reading from ak=1 owner=0, which means it asked and nothing owns the wait.
+ */
+static void
+clover_wait_owner(thread_t thr, uint32_t *hint, uint32_t *asked, uint64_t *owner,
+    uint64_t *ctx)
+{
+	thread_waitinfo_t wi;
+
+	bzero(&wi, sizeof(wi));
+	*hint = (uint32_t)thr->block_hint;
+	*asked = 0;
+	*owner = 0;
+	*ctx = 0;
+	if ((thr->state & TH_WAIT) == 0 || thr->wait_event == 0) {
+		return;
+	}
+	switch ((block_hint_t)*hint) {
+	case kThreadWaitSemaphore:
+		kdp_sema_find_owner(thr->waitq.wq_q, thr->wait_event, &wi);
+		*asked = 1;
+		*owner = wi.owner;
+		*ctx = wi.context;
+		break;
+	case kThreadWaitUserLock:
+		kdp_ulock_find_owner(thr->waitq.wq_q, thr->wait_event, &wi);
+		*asked = 1;
+		*owner = wi.owner;
+		*ctx = wi.context;
+		break;
+	case kThreadWaitWorkloopSyncWait:
+		kdp_workloop_sync_wait_find_owner(thr, thr->wait_event, &wi);
+		*asked = 1;
+		*owner = wi.owner;
+		*ctx = wi.context;
+		break;
+	default:
+		break;
+	}
+}
