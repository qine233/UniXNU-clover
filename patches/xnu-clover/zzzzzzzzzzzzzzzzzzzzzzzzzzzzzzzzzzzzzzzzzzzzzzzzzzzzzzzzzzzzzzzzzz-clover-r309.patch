+/*
+ * Round309. The census sampler's own two ends, delivered only through the driver relay -- no printf copy, because the
+ * leg being measured is the console one. Eleven boots asked whether the walk after the latch ever ran and could only
+ * answer from rows that ride the console pipeline those rows are the evidence about; boot 100 answered a different
+ * question (the latch opened at t=433 and the boot reset before the 120 s beat that would have
+ * reported it). These two rows are what the pre-registration asked for: they name the entry and the
+ * return without going through the tee, and they read ent= and fired= from the same variables the beat
+ * row names, so a row cannot disagree with the counter it measures. The in row appears once -- on the
+ * first entry of the boot, which is the entry the latch made possible. The out row appears only when
+ * the named return changes, because backboardd returning `same` every 20 s is one reading, not
+ * twenty-two rows competing with every other instrument for the relay's 64 slots.
+ */
+static void
+clover_r309_cen_in(uint64_t secs, int pid)
+{
+	extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+	char row[128];
+	int len;
+
+	if (clover_bb_enters != 1) {
+		return;
+	}
+	len = snprintf(row, sizeof(row),
+	    "clover r309: cen-in t=%llu pid=%d ent=%u\n",
+	    (unsigned long long)secs, pid, clover_bb_enters);
+	if (len > 0) {
+		row[sizeof(row) - 1] = '\0';
+		clover_emmc_probe_say(row, (unsigned int)strlen(row));
+	}
+}
 
 static void
+clover_r309_cen_out(const char *why, uint64_t secs, int pid)
+{
+	extern unsigned int clover_emmc_probe_say(const char *text, unsigned int length);
+	static char last[16];
+	char row[128];
+	int len;
+
+	if (strcmp(why, last) == 0) {
+		return;
+	}
+	strlcpy(last, why, sizeof(last));
+	len = snprintf(row, sizeof(row),
+	    "clover r309: cen-out t=%llu pid=%d why=%s fired=%u\n",
+	    (unsigned long long)secs, pid, why, clover_bb_fired);
+	if (len > 0) {
+		row[sizeof(row) - 1] = '\0';
+		clover_emmc_probe_say(row, (unsigned int)strlen(row));
+	}
+}
