+
+/*
+ * Round264. Two numbers read straight off the port object a thread is receiving
+ * on, and together they decide a shape no register can: whether anyone can still
+ * post to that port at all. ip_messages.imq_msgcount is the mail already sitting
+ * in the queue -- a waiter with mail queued is an instrument error, not a finding
+ * -- and ip_srights is the count of send rights that exist, so zero of both means
+ * no code path in any task can ever wake this thread again. Both are read without
+ * the port lock: a sample, correct to the beat, and stated as such because the
+ * queue is being changed by other cpus while this prints.
+ */
+static void
+clover_sb_port_mail(task_t task, mach_port_name_t name, uint32_t *mc, uint32_t *sr)
+{
+	ipc_space_t space;
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	kern_return_t kr;
+
+	*mc = 0;
+	*sr = 0;
+	if (name == MACH_PORT_NULL) {
+		return;
+	}
+	space = task->itk_space;
+	if (space == IPC_SPACE_NULL) {
+		return;
+	}
+	kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_RECEIVE, &obj);
+	if (kr != KERN_SUCCESS) {
+		kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_SEND, &obj);
+	}
+	if (kr != KERN_SUCCESS) {
+		return;
+	}
+	if (io_otype(obj) == IOT_PORT) {
+		ipc_port_t port = (ipc_port_t)obj;
+
+		*mc = port->ip_messages.imq_msgcount;
+		*sr = port->ip_srights;
+	}
+	io_unlock(obj);
 }
 
