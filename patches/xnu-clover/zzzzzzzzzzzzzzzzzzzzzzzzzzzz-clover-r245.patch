+/*
+ * Round245. This translation unit does not pull in <string.h>, and a registry
+ * name is short by construction, so the containment test is written out.
+ */
+static bool
+clover_name_has(const char *name, const char *part)
+{
+	if (name == NULL || part == NULL) {
+		return false;
+	}
+	for (const char *head = name; *head != '\0'; head++) {
+		const char *a = head;
+		const char *b = part;
+		while (*b != '\0' && *a == *b) {
+			a++;
+			b++;
+		}
+		if (*b == '\0') {
+			return true;
+		}
+	}
+	return false;
+}
