@@ -12848,8 +12848,18 @@
 static void
 clover_census_row(const char *line)
 {
-	printf("%s", line);
+	/*
+	 * Round305. The relay goes first. Round304 put the two copies in the order the row already had --
+	 * console, then the driver's ring -- so a boot that dies inside the console path loses both at once,
+	 * and the card cannot say which of its two channels went quiet. Boot 94 is that reading: the census
+	 * head is on the card and every row after it is missing from both. Handing the bytes to the ring
+	 * first splits the two again: kind-25 rows with no kind-22 pair means the row was made and the
+	 * console is where it stopped, and neither means the walk never reached this line. The handover is
+	 * one atomic slot counter plus a copy, so putting it first costs the census path nothing it was not
+	 * already paying.
+	 */
 	clover_emmc_probe_say(line, (unsigned int)strlen(line));
+	printf("%s", line);
 }
 
