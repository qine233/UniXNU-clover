+/*
+ * Round239. The host proved what the wait is: -[BKButtonHapticsController
+ * applyDefinitions:] dispatches a block whose body loads its captured controller
+ * from block+0x20, reads the controller's _controllerReadyGroup at +0x38 and
+ * parks in ___ulock_wait on that group's dg_gen (backboardd file offset 0x303c4,
+ * the bl at 0x303e0, the return address 0x303e4 the frame chain carries). The
+ * block pointer itself only lives in the block body's own frame -- that frame
+ * pushed x19 eight bytes below its link -- because a blocked thread's *live*
+ * x19 belongs to whichever libdispatch frame is innermost. So the chain is
+ * searched for rather than assumed: every frame the walker names offers the slot
+ * below its link as a candidate block, and a candidate is accepted only when the
+ * pointer it captures at +0x20 names an object whose +0x38 is exactly the group
+ * this thread waits on. A stack word that merely looks like a pointer does not
+ * survive that test.
+ */
+static int
+clover_bb_find_block(pmap_t pmap, const uint64_t *callers, uint32_t fn,
+    uint64_t group, uint64_t *blk, uint64_t *inv, uint64_t *isa, uint64_t *self,
+    uint64_t *sisa, uint64_t *def, uint64_t *disa, uint32_t *at)
+{
+	uint32_t i;
+
+	for (i = 0; i < fn; i++) {
+		uint64_t cand = 0, captured = 0, hold = 0;
+
+		if (callers[i] <= 8) {
+			continue;
+		}
+		if (!clover_user_read64(pmap, callers[i] - 8, &cand) ||
+		    cand == 0 || (cand & 7) != 0 || cand >= 0x10000000000ULL) {
+			continue;
+		}
+		if (!clover_user_read64(pmap, cand + 0x10, inv) ||
+		    !clover_user_read64(pmap, cand + 0x20, &captured) ||
+		    captured == 0 || (captured & 7) != 0 ||
+		    captured >= 0x10000000000ULL) {
+			continue;
+		}
+		if (!clover_user_read64(pmap, captured + 0x38, &hold) ||
+		    hold != group) {
+			continue;
+		}
+		*blk = cand;
+		*self = captured;
+		*at = i;
+		if (!clover_user_read64(pmap, cand, isa)) {
+			*isa = 0;
+		}
+		if (!clover_user_read64(pmap, captured, sisa)) {
+			*sisa = 0;
+		}
+		*def = 0;
+		*disa = 0;
+		if (clover_user_read64(pmap, captured + 0x20, def) &&
+		    *def != 0 && (*def & 7) == 0 && *def < 0x10000000000ULL) {
+			if (!clover_user_read64(pmap, *def, disa)) {
+				*disa = 0;
+			}
+		}
+		return 1;
+	}
+	return 0;
+}
