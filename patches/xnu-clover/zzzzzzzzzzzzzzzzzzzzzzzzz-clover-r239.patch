+/*
+ * Round239. A heap slot that holds a pointer is 8 bytes wide, and the two halves
+ * may sit in different pages, so each half gets its own translation. The range
+ * test is the one the wait rows already use: below the kernel base and aligned.
+ */
+static int
+clover_user_read64(pmap_t pmap, uint64_t addr, uint64_t *value)
+{
+	uint32_t lo, hi;
+
+	if (addr == 0 || (addr & 3) != 0 || addr >= 0x10000000000ULL) {
+		return 0;
+	}
+	if (!clover_user_read32(pmap, addr, &lo) ||
+	    !clover_user_read32(pmap, addr + 4, &hi)) {
+		return 0;
+	}
+	*value = (uint64_t)lo | ((uint64_t)hi << 32);
+	return 1;
+}
