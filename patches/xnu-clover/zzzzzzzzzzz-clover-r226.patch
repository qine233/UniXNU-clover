+/*
+ * Round226. The r225 frame named the kill site through a slide the host had to
+ * derive: ulr 0x10086a144 minus backboardd's 0x7F8000 is image offset 0x71ee4,
+ * the return of the second `bl _kill`, inside the "Killing %@" helper. What the
+ * slide cannot say is why that helper picked this process. The caller's own
+ * registers can: x0 is the pid that was passed to kill(2), the stack words
+ * under sp are the arguments its caller built, and both are printed raw here
+ * -- no translation, no mapping lookup, because the point is to read the
+ * decision, not to name an address. Layout: x0..x28, fp, lr, sp, pc, cpsr.
+ */
+uint32_t
+clover_sender_regs(uint64_t *out, uint32_t max)
+{
+	thread_t thr = current_thread();
+	arm_saved_state_t *ss;
+	arm_saved_state64_t *s64;
+	uint32_t n = 0;
+	uint32_t i;
+
+	if (thr == THREAD_NULL || out == NULL || max < 34) {
+		return 0;
+	}
+	ss = get_user_regs(thr);
+	if (ss == NULL || (uintptr_t)ss == (uintptr_t)-1 || is_saved_state32(ss)) {
+		return 0;
+	}
+	s64 = saved_state64(ss);
+	for (i = 0; i < 29; i++) {
+		out[n++] = (uint64_t)s64->x[i];
+	}
+	out[n++] = (uint64_t)get_saved_state_fp(ss);
+	out[n++] = (uint64_t)get_saved_state_lr(ss);
+	out[n++] = (uint64_t)get_saved_state_sp(ss);
+	out[n++] = (uint64_t)get_saved_state_pc(ss);
+	out[n++] = (uint64_t)get_saved_state_cpsr(ss);
+	return n;
+}
 #endif /* __arm64__ */
