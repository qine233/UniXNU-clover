 }
 
+/*
+ * Round226. ipc_object_translate asks for a right type, and the launchd send
+ * descriptors name a send-once right, which no translate right covers: that is
+ * the kr=17 of rounds 223-225, not a dead port. The entry table answers the
+ * same question without nursing a right: the entry carries the port object
+ * whatever right the name holds. The space lock keeps the entry alive while
+ * its object is locked and referenced, the same order translate uses.
+ */
+static task_t
+clover_port_recv_task(ipc_space_t space, mach_port_name_t name)
+{
+	ipc_entry_t entry;
+	ipc_object_t obj;
+	task_t owner = TASK_NULL;
+
+	is_read_lock(space);
+	entry = ipc_entry_lookup(space, name);
+	if (entry != NULL && (obj = entry->ie_object) != IPC_OBJECT_NULL) {
+		io_lock(obj);
+		if (io_otype(obj) == IOT_PORT) {
+			ipc_space_t recv = ip_get_receiver((ipc_port_t)obj);
+
+			if (recv != IPC_SPACE_NULL && recv->is_task != TASK_NULL) {
+				owner = recv->is_task;
+				task_reference(owner);
+			}
+		}
+		io_unlock(obj);
+	}
+	is_read_unlock(space);
+	return owner;
+}
