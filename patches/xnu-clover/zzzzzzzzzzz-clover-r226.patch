+/*
+ * Round226. r225 watched SpringBoard send and saw the reply arrive on a03,
+ * but the thread that ended up blocked was waiting on 7b03/1d07 with a message
+ * already queued -- so the question moved to the receive side: which port did
+ * it park on, and what was already in that port's queue when it parked. This
+ * runs on every blocking receive in the system, so the gate is one load and
+ * one pointer compare, and the line is printed only when the (port, count,
+ * id) triple changes, thirty-two times at most. Callers hold the waitq lock.
+ */
+#if defined(__arm64__)
+extern int clover_sb_is_current(void);
+
+static void
+clover_r226_port_note(ipc_port_t port, uint32_t kind, uint64_t secs)
+{
+	static uintptr_t last_key;
+	static uint32_t last_cnt;
+	static uint32_t last_id;
+	static uint32_t prints;
+	ipc_kmsg_t kmsg;
+	mach_msg_header_t *mh;
+	uint32_t cnt;
+	uint32_t id = 0;
+	uintptr_t key;
+
+	if (prints >= 32) {
+		return;
+	}
+	cnt = port->ip_messages.imq_msgcount;
+	kmsg = ipc_kmsg_queue_first(&port->ip_messages.imq_messages);
+	mh = (kmsg != IKM_NULL) ? ikm_header(kmsg) : NULL;
+	if (mh != NULL) {
+		id = mh->msgh_id;
+	}
+	key = (uintptr_t)port ^ ((uintptr_t)kind << 3);
+	if (key == last_key && cnt == last_cnt && id == last_id) {
+		return;
+	}
+	last_key = key;
+	last_cnt = cnt;
+	last_id = id;
+	prints++;
+	printf("clover r226: sbrcv t=%llu tid=0x%llx k=%u cnt=%u ql=%u seq=%u"
+	    " rn=%x ms=%u sr=%u kobj=%llx h=%x.%x.%x.%x.%x.%x\n",
+	    (unsigned long long)secs,
+	    (unsigned long long)current_thread()->thread_id, kind, cnt,
+	    (unsigned)port->ip_messages.imq_qlimit,
+	    (unsigned)port->ip_messages.imq_seqno,
+	    port->ip_messages.imq_receiver_name,
+	    (unsigned)port->ip_mscount,
+	    (unsigned)port->ip_srights,
+	    (unsigned long long)port->ip_kobject,
+	    (unsigned)(mh != NULL ? mh->msgh_bits : 0),
+	    (unsigned)(mh != NULL ? mh->msgh_size : 0),
+	    (unsigned)(mh != NULL ? mh->msgh_remote_port : 0),
+	    (unsigned)(mh != NULL ? mh->msgh_local_port : 0),
+	    (unsigned)(mh != NULL ? mh->msgh_voucher_port : 0),
+	    (unsigned)(mh != NULL ? mh->msgh_id : 0));
+}
+
+static void
+clover_r226_receive_note(struct waitq *waitq)
+{
+	static uintptr_t last_set;
+	static uint32_t set_prints;
+	uint64_t ns = 0;
+	int ty;
+
+	if (!clover_sb_is_current()) {
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	ty = waitq_type(waitq);
+	if (ty == WQT_PORT) {
+		clover_r226_port_note(ip_from_waitq(waitq), 0, ns / 1000000000ULL);
+		return;
+	}
+	if (set_prints < 8 && last_set != (uintptr_t)io_from_waitq(waitq)) {
+		last_set = (uintptr_t)io_from_waitq(waitq);
+		set_prints++;
+		printf("clover r226: sbrcv t=%llu tid=0x%llx k=1 ty=%d obj=%llx\n",
+		    (unsigned long long)(ns / 1000000000ULL),
+		    (unsigned long long)current_thread()->thread_id, ty,
+		    (unsigned long long)last_set);
+	}
+}
+#else
+#define clover_r226_receive_note(w) do { (void)(w); } while (0)
+#endif /* __arm64__ */
+
