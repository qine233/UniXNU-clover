+/*
+ * Round233. The wait rows name the lock address and nothing else. The word
+ * lives in the receiver's memory, so it is read through that task's map: copyin
+ * only sees the current task, and the current task is this kernel thread or
+ * SpringBoard, never backboardd. libplatform keeps the owner's mach thread port
+ * name in the low bits with bit 0 marking waiters (lock.c, OS_ULOCK_OWNER), so
+ * the owner is resolved as a thread control port in the same space and printed
+ * with its thread id and state -- that is the holder the blocked thread waits
+ * for. Only lock-wait opcodes are read; other wait rows carry unrelated words.
+ */
+extern kern_return_t copyinmap(vm_map_t, vm_map_offset_t, void *, vm_size_t);
+
+static void
+clover_bb_lock_word(task_t task, uint64_t tid, uint64_t op, uint64_t addr,
+    uint32_t st, uint64_t secs)
+{
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	thread_t owner = THREAD_NULL;
+	kern_return_t kr;
+	uint32_t word = 0;
+	uint32_t own;
+	uint64_t ownid = 0;
+	uint32_t ownst = 0;
+	int is_lock;
+
+	is_lock = (op == 0x1000001ULL) || (op == 0x40ULL) || (op == 0x100ULL) ||
+	    ((op & 0xFFFF00FFULL) == 0x01000000ULL && (op & 0xff) >= 1 &&
+	    (op & 0xff) <= 4);
+	if (!is_lock || addr == 0 || addr >= 0x10000000000ULL) {
+		return;
+	}
+	if (copyinmap(task->map, (vm_map_offset_t)(addr & ~3ULL), &word,
+	    sizeof(word)) != KERN_SUCCESS) {
+		printf("clover r233: bblock t=%llu tid=0x%llx op=%llx a=%llx"
+		    " st=%x rd=err\n", (unsigned long long)secs,
+		    (unsigned long long)tid, (unsigned long long)op,
+		    (unsigned long long)addr, st);
+		return;
+	}
+	own = word & ~1u;
+	if (own != 0 && own != (uint32_t)MACH_PORT_DEAD &&
+	    task->itk_space != IPC_SPACE_NULL) {
+		kr = ipc_object_translate(task->itk_space,
+		    (mach_port_name_t)own, MACH_PORT_RIGHT_SEND, &obj);
+		if (kr != KERN_SUCCESS) {
+			kr = ipc_object_translate(task->itk_space,
+			    (mach_port_name_t)own, MACH_PORT_RIGHT_RECEIVE,
+			    &obj);
+		}
+		if (kr == KERN_SUCCESS) {
+			if (io_otype(obj) == IOT_PORT) {
+				owner = (thread_t)ipc_kobject_get_locked(
+				    (ipc_port_t)obj, IKOT_THREAD_CONTROL);
+				if (owner != THREAD_NULL) {
+					ownid = owner->thread_id;
+					ownst = owner->state;
+				}
+			}
+			io_unlock(obj);
+		}
+	}
+	printf("clover r233: bblock t=%llu tid=0x%llx op=%llx a=%llx st=%x"
+	    " w=%08x own=%x ow=0x%llx ost=%x\n",
+	    (unsigned long long)secs, (unsigned long long)tid,
+	    (unsigned long long)op, (unsigned long long)addr, st, word,
+	    (unsigned)own, (unsigned long long)ownid, ownst);
+}
