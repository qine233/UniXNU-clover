+/*
+ * Round233. The blocked send names its destination in SpringBoard's space; the
+ * port-set walk needs the object behind the name so it can mark the member that
+ * holds the message. The translate returns the object locked and without a
+ * reference, and only the address is kept: a stale address costs nothing more
+ * than a member row without its mark.
+ */
+static void
+clover_bb_note_mark(task_t sb_task, mach_port_name_t name)
+{
+	ipc_space_t space;
+	ipc_object_t obj = IPC_OBJECT_NULL;
+	kern_return_t kr;
+
+	if (name == MACH_PORT_NULL || sb_task == TASK_NULL) {
+		return;
+	}
+	space = sb_task->itk_space;
+	if (space == IPC_SPACE_NULL) {
+		return;
+	}
+	kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_SEND, &obj);
+	if (kr != KERN_SUCCESS) {
+		kr = ipc_object_translate(space, name, MACH_PORT_RIGHT_RECEIVE,
+		    &obj);
+	}
+	if (kr != KERN_SUCCESS) {
+		return;
+	}
+	if (io_otype(obj) == IOT_PORT) {
+		__atomic_store_n(&clover_bb_mark_obj, (uint64_t)(uintptr_t)obj,
+		    __ATOMIC_RELEASE);
+	}
+	io_unlock(obj);
 }
