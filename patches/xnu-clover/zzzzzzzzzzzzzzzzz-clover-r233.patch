+/*
+ * Round233. The port's state says what is queued; it does not say who serves
+ * the name. The owner is resolved from the same space the state was read in, in
+ * a row of its own: the name inside a set is not a member's name, so this is
+ * also the only place a set's receiver task is named. The lookup runs with no
+ * object lock held (clover_sb_port_owner takes the space lock, then the port
+ * lock itself), which is why it cannot ride inside the state row's lock.
+ *
+ * A receiver does not change hands, so the row is printed when the owner for a
+ * name changes or on a ten-minute heartbeat. The state rows themselves are
+ * already gated by signature, and this row follows them; without its own gate a
+ * send-heavy boot would spend the class budget naming the same task.
+ */
+static void
+clover_sb_owner_row(task_t task, mach_port_name_t name, const char *tag,
+    uint64_t secs)
+{
+	static struct {
+		task_t task;
+		mach_port_name_t name;
+		uint64_t last;
+		char own[24];
+	} rows[8];
+	char own[24];
+	char line[320];
+	uint32_t i;
+	int slot = -1;
+	int len;
+
+	clover_sb_port_owner(task, name, own, sizeof(own));
+	for (i = 0; i < 8; i++) {
+		if (rows[i].task == task && rows[i].name == name &&
+		    rows[i].own[0] != '\0') {
+			slot = (int)i;
+			break;
+		}
+	}
+	if (slot >= 0 && strcmp(rows[slot].own, own) == 0 &&
+	    secs - rows[slot].last < 600) {
+		return;
+	}
+	if (slot < 0) {
+		for (i = 0; i < 8; i++) {
+			if (rows[i].task == TASK_NULL) {
+				slot = (int)i;
+				break;
+			}
+		}
+	}
+	if (slot >= 0) {
+		rows[slot].task = task;
+		rows[slot].name = name;
+		rows[slot].last = secs;
+		strlcpy(rows[slot].own, own, sizeof(rows[slot].own));
+	}
+	len = snprintf(line, sizeof(line),
+	    "clover r233: sbown t=%llu %s nm=%x own=%s\n",
+	    (unsigned long long)secs, tag, name, own[0] ? own : "-");
+	if (len > 0) {
+		line[sizeof(line) - 1] = '\0';
+		printf("%s", line);
+	}
+}
