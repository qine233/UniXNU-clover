+/*
+ * Round233. Every earlier sampling beat was driven from a mach-trap entry, so
+ * the readings stopped when the userland that enters those traps stopped. Boot
+ * 21's ring ends at 1763 s with the kernel still scheduling, and the one thing
+ * the ring could not answer was whether the kernel was alive after that. A
+ * kernel thread answers it without asking userland: it wakes on its own timer
+ * every twenty seconds, prints a heartbeat every two minutes, and takes the same
+ * backboardd/SpringBoard reading the trap path used to take. The twenty-second
+ * period matches the old beat; clover_bb_sample still suppresses an unchanged
+ * receiver, so the period only decides how fast a change is seen.
+ *
+ * The task reference is taken under the latched pointer, which the latch never
+ * frees (see clover_sb_note_current), and the pid/name are read as plain words:
+ * they are latched once and only ever cleared, so a torn read is not possible.
+ */
+static void
+clover_bb_beat_thread(void *param, wait_result_t wres)
+{
+	uint64_t last_beat = 0;
+
+	(void)param;
+	(void)wres;
+	for (;;) {
+		wait_result_t wr;
+		task_t sb;
+		uint64_t secs;
+
+		assert_wait_timeout((event_t)clover_bb_beat_thread,
+		    THREAD_INTERRUPTIBLE, 20, NSEC_PER_SEC);
+		wr = thread_block(THREAD_CONTINUE_NULL);
+		if (wr != THREAD_TIMED_OUT) {
+			continue;
+		}
+		sb = __atomic_load_n(&clover_sb_task, __ATOMIC_ACQUIRE);
+		if (sb == TASK_NULL) {
+			continue;
+		}
+		task_reference(sb);
+		secs = clover_now_seconds();
+		if (last_beat == 0 || secs >= last_beat + 120) {
+			last_beat = secs;
+			printf("clover r233: beat t=%llu pid=%d rn=%x rep=%x\n",
+			    (unsigned long long)secs, clover_bb_target_pid,
+			    clover_bb_target_name, clover_sb_last_reply);
+			/*
+			 * Round233. SpringBoard's reply port rides the heartbeat, not
+			 * the 20 s beat: four rows a minute is enough to see whether
+			 * anything is ever queued on it, and the r233 tee class has to
+			 * hold the member dump too.
+			 */
+			if (clover_sb_last_reply != MACH_PORT_NULL) {
+				clover_sb_port_state(sb, clover_sb_last_reply,
+				    "sbrep", secs, "r233");
+			}
+		}
+		if (clover_bb_target_pid != 0) {
+			clover_bb_sample(clover_bb_target_pid, sb,
+			    clover_bb_target_name, secs);
+		}
+		task_deallocate(sb);
+	}
+}
+
+static void
+clover_bb_start_beat(void)
+{
+	thread_t thr = THREAD_NULL;
+
+	if (__atomic_exchange_n(&clover_bb_beat_started, 1,
+	    __ATOMIC_ACQ_REL) != 0) {
+		return;
+	}
+	if (kernel_thread_start((thread_continue_t)clover_bb_beat_thread, NULL,
+	    &thr) == KERN_SUCCESS) {
+		thread_deallocate(thr);
+	}
+}
